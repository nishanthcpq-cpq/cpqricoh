//creates JSON object and then 
//calls all pricing scripts in the correct order

quoteJSON = json(); // will be sent to each pricing script
headerJSON = json(); //
jsonput(headerJSON, "_system_company_name", _system_company_name);
jsonput(headerJSON, "_system_buyside_id", _system_buyside_id);
jsonput(headerJSON, "transactionID_t", transactionID_t);
jsonput(headerJSON, "_system_current_step_var", _system_current_step_var);
jsonput(headerJSON, "defaultRequestDate_t", defaultRequestDate_t);
jsonput(headerJSON, "contractStartDate_t", contractStartDate_t);
jsonput(headerJSON, "contractEndDate_t", contractEndDate_t);
jsonput(headerJSON, "modelsContainsInQuote_t", modelsContainsInQuote_t);

jsonput(headerJSON, "termMonths_t", termMonths_t);
jsonput(headerJSON, "contractOtherTerm_t", contractOtherTerm_t);

jsonput(headerJSON, "pIOFlag_c", pIOFlag_c);
jsonput(headerJSON, "rebateType_t", rebateType_t);
jsonput(headerJSON, "rebateValue_t", rebateValue_t);
jsonput(headerJSON, "acquisitionType_t", acquisitionType_t);
jsonput(headerJSON, "pricelistRateFlag_c", pricelistRateFlag_c);

// trade-in fields

jsonput(headerJSON, "iTSMRRTotalDealPricingMethod_c", iTSMRRTotalDealPricingMethod_c);
