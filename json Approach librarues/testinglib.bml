                    jsonput(lineJSON, "marginPercentagestdscost_l", marginPercentagestdscost);
                }
                //CR100
                if (RsiTotalCondition == false AND ((discounttype_l == "" AND businessLine_c <> "TRADITIONAL") OR (discounttype_l <> "" AND businessLine_c <> "TRADITIONAL" AND pricelistRateFlag_c) OR ((discountApplied == false OR (discountApplied == true AND ActionTrigger == "Before Formulas")) AND model_name == "" AND businessLine_c == "TRADITIONAL"))) {
