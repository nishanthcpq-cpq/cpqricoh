                }
                if (perfPassedPromoStr <> "") {
                    perfPassedPromoJson = json(perfPassedPromoStr);
                    promotionjsonarray = jsonget(perfPassedPromoJson, "rows", "jsonarray");
                }
                discounttype = discounttype_l;
                discountValueLine = string(discountAmountt_l);
                discountAmt = 0.0;
                promocode = promoTypevalue;


                promoValueAmt = 0.0;
                promoTypevalue = "";
                promoValue = 0.0;
                promoDescription = "";
                path = "$.Promotionjson[? (@.ItemNumber == '" + part_number + "') ]";
                if (jsonpathcheck(Promotionjson1, path)) {
                    // print "%%%%%%%%  Inside path item found %%%%%%%%%"; //print path ;
                    startDate = jsonpathgetsingle(Promotionjson1, path + ".StartDate");
                    endDate = jsonpathgetsingle(Promotionjson1, path + ".EndDate");
                    if (sysdate >= startDate AND sysdate <= endDate) {
                        promoValue = atof(jsonpathgetsingle(Promotionjson1, path + ".DiscountValue"));
                        promoDescription = jsonpathgetsingle(Promotionjson1, path + ".Description");
                        promotionTypeTable = jsonpathgetsingle(Promotionjson1, path + ".PromoType");
                        if (promotionTypeTable == "Amount") {
                            promoValueAmt = promoValue;
                            unitNetPrice = unitSellingPrice - promoValue;
                        }
                        if (promotionTypeTable == "Percent") {
                            promoValueAmt = (((promoValue) / 100) * unitSellingPrice);
                            unitNetPrice = unitSellingPrice - (((promoValue) / 100) * unitSellingPrice);
                        }
                        if (promotionTypeTable == "Override") {
                            promoValueAmt = promoValue;
                            unitNetPrice = promoValue;
                        }
                        extnetsellprice = unitNetPrice * price_quantity;
                    }
                }
                if (discounttype == "") {
                    discountValueLine = "0.0";
                    unitSellingPrice = contractedPrice;
                }
                if (discounttype == "Stretch") {
                    discountValueLine = "0.0";
                    unitSellingPrice = contractedPrice;
                }
                if (discounttype == "Override") {
                    discountAmt = atof(discountValueLine);
                    unitSellingPrice = atof(discountValueLine);
                }
                if (discounttype == "Amount") {
                    discountAmt = atof(discountValueline);
                    unitSellingPrice = (contractedPrice) - atof(discountValueline);
                }
                /*    print "discounttype:" + discounttype;
                    print "discountValueline:" + discountValueline;
                    print "contractedPrice:" + string(contractedPrice); */
                //  print _part_number ;
                if (discounttype == "Percent") {

                    discountAmt = ((atof(discountValueline) / 100) * contractedPrice);
                    unitSellingPrice = contractedPrice - ((atof(discountValueline) / 100) * contractedPrice);

                }
                extSellingPrice = (unitSellingPrice * price_quantity);
                //     print discountAmt;
                if (promocode == "") {

                    //print "asxcfswdafdcacfvs"; //
                    unitNetPrice = unitSellingPrice;
                    extnetsellprice = unitNetPrice * price_quantity;
