            partNumber = part_number;
            vendorCost = vendorUnitCost_l;
            listPrice = 0.0;
            //print "vendorCost"; print vendorCost ;
            if (racUserOrg_c == "RUS" OR racUserOrg_c == "") {
                listPrice = part_custom_field7;
            } elif (racUserOrg_c == "RCI" AND part_custom_field318 <> "" AND not(isnull(part_custom_field318))) {
