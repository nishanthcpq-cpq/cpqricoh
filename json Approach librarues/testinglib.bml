                roundExtSRP = round(extSRP, 2);

                if (startswith(part_number, "FIPS")) {
                    roundExtSRP = round(extSRP, 4);
                }
                roundUnitCost = round(unitStandardCost, 4);
                if (startswith(part_number, "FIPS")) {
