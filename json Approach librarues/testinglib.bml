            }
            if (modelnameforpart == "Equipment") {
                defaultListPrice = price_configurable_price;
                vendoecost = vendorCost_c;
                listPrice = vendorCost_c;
            }

            if (line_bom_attributes <> "" AND line_bom_attributes <> "{}") {
                bomjson = json(line_bom_attributes);
                BOM_price = jsonpathgetsingle(bomjson, "$.EquipmentPricing.value");
                //Chandra: added isnumber check for 34733
                if (isnumber(BOM_price) AND BOM_price <> "null") {
                    defaultListPrice = atof(BOM_price);
                }
            }
            if (discounttype == "") {
                discountValueLine = "0.0";
                unitsellprice = defaultListPrice;
                //print "defaultListPrice--"+ string(defaultListPrice );
            } else {
                print discounttype_l;
                print discountAmountt_l;
                print part_number;

                if (discounttype == "Override") {
                    discountAmt = atof(discountValueLine);
                    unitsellprice = atof(discountValueLine);
                } elif (discounttype == "Amount") {
                    discountAmt = atof(discountValueline);
                    unitsellprice = (defaultListPrice) - atof(discountValueline);
                } elif (discounttype == "Percent") {
                    discountAmt = ((atof(discountValueline) / 100) * defaultListPrice);
                    unitsellprice = defaultListPrice - ((atof(discountValueline) / 100) * defaultListPrice);
                } elif (discounttype == "Stretch") {
                    unitsellprice = defaultListPrice;
                }
            }
            extSellingPrice = (unitsellprice * price_quantity);
            path = "$.Promotionjson[? (@.ItemNumber == '" + part_number + "') ]";
            if (jsonpathcheck(Promotionjson1, path)) {
                //   print "%%%%%%%%  Inside path item found %%%%%%%%%"; //print path ;

                if (promocode == "") {
                    unitnetsellprice = unitsellprice;
                    extnetsellprice = unitnetsellprice * price_quantity;

                }
                startDate = jsonpathgetsingle(Promotionjson1, path + ".StartDate");
                endDate = jsonpathgetsingle(Promotionjson1, path + ".EndDate");
                if (sysdate >= startDate AND sysdate <= endDate) {

                    promoValue = atof(jsonpathgetsingle(Promotionjson1, path + ".DiscountValue"));
                    promoDescription = jsonpathgetsingle(Promotionjson1, path + ".Description");
                    promotionTypeTable = jsonpathgetsingle(Promotionjson1, path + ".PromoType");
                    promoTypevalue = promotionTypeTable;



                    if (promotionTypeTable == "Amount") {
                        promoValueAmt = promoValue;
                        unitnetsellprice = unitsellprice - promoValue;
                    }
                    if (promotionTypeTable == "Percent") {
                        promoValueAmt = (((promoValue) / 100) * unitsellprice);
                        unitnetsellprice = unitsellprice - (((promoValue) / 100) * unitsellprice);
                    }
                    if (promotionTypeTable == "Override") {
                        promoValueAmt = promoValue;
                        unitnetsellprice = promoValue;
                    }
                    //Below roundoff added by Namrata for defect#34268 as part of 2.0
                    unitnetsellprice = round(unitnetsellprice, 2);
                    extnetsellprice = unitnetsellprice * price_quantity;
                    //}
                }
            }

            customSequenceForProposal = 0;
            if (customSequenceForProposal_l > 0) {
                customSequenceForProposal = customSequenceForProposal_l;
            } elif (customSequenceSuffix_l > 0) {
                customSequenceForProposal = customSequenceSuffix_l;
            } else {
                customSequenceForProposal = sequence_number;
            }


            //END 08_16_2023 PERFORMANCE_ACTIVITIES added by Vasundhara
            if (derivedFrom == "Calcualtions on Transaction Line - Before Formulas" OR derivedFrom == "Before Formulas") {

                unitSRP = defaultListPrice;

                if (vendorQuoteNumber_VLIG <> "") {
                    unitSRP = unitSRPBackend_l;

                } elif (vpFlag) {

                    unitSRP = unitSellingPrice;
                }
                if (unitSRPBackend_l > 0 AND modelnameforpart <> "Equipment") {
                    unitSRP = unitSRPBackend_l;
                }
                if (FIPItemsFlag == "Y") {
                    unitSRP = (defaultListPrice / 2) * FIPvalidFieldQty;
                }
                if (((businessLine_c == "ITS" OR businessLine_c == "PS") AND vendoecost > 0.0 AND modelnameforpart == "Equipment") OR (businessLine_c == "ITS" AND vendoecost > 0.0 AND part_custom_field27 <> "VP")) {
                    unitStandardCost = vendoecost;
                } else {
                    if (vpFlag) {
                        unitStandardCost = unitSellingPrice * (1 - minGPPercentage);
                    } elif (vendorCost_c > 0.01) {
                        unitStandardCost = vendorCost_c;
                    } elif ((vendorCost_c == 0.0 OR vendorCost_c == 0.01) AND frozenCost > 0.01) {
                        unitStandardCost = frozenCost;
                        //print "frozenCost"; print frozenCost;
                    } elif ((vendorCost_c == 0.0 OR vendorCost_c == 0.01 OR frozenCost == 0.0 OR frozenCost == 0.01 OR (substring(part_number, 4, len(part_number)) == "-DS" OR substring(part_number, 4, len(part_number)) == "-PS1") OR (businessLine_c == "PS" OR businessLine_c == "ITS")) AND listPrice > 0.01) //02_08_2023_Added Condition Vendor Cost =  = 0.0/0.01 for PS_Pricing by Vasundhara	{
                    {
                        unitStandardCost = listPrice;
                    } else {
                        unitStandardCost = unitSRP * (1 - minGPPercentage);
                        //print "minGPPercentage--" + string(minGPPercentage);
                    }
                }

                if (FIPItemsFlag == "Y") {
                    unitStandardCost = (listPrice / 2) * FIPvalidFieldQty;
                }
                if (part_number == "FIPSBPS5174" OR part_number == "FIPSBPS5227") {
                    unitStandardCost = listPrice;
                }

                if (lower(modelName_l_c) <> "hardware") {

                    initialSalesCost = (unitStandardCost - sMA) * (1 + productFloor + sgaSegement);

                } else {
                    initialSalesCost = (unitStandardCost - sMA) * (1 + productFloor);

                }

                if (cashPrice > 0.0) {
                    initialSalesCost = initialSalesCost + (cashPrice * (rebatePercentage / 100)); //print "%%34fr34f4rtgvrt4g%%" ;
                    CONTRACTED_FLG = true;
                    CONTRACTED_UI_FLG = "True";
                    //  print initialSalesCost;
                    //  print cashPrice;
                    //   print rebatePercentage;

                } elif (codePresent == "true" AND cashPrice == 0.0) { //09_06_2023 Added the elif condition for PS_Pricing by Vasundhara PS_Pricing
                    initialSalesCost = 0.0;
                    CONTRACTED_FLG = false;
                    CONTRACTED_UI_FLG = "False";

                } else {

                    initialSalesCost = initialSalesCost + (initialSalesCost * (rebatePercentage / 100));
                    //print "rebatePercentage"; print rebatePercentage; print initialSalesCost;
                    CONTRACTED_FLG = false;
                    CONTRACTED_UI_FLG = "False";

                }
                finalSalesCost = 0.0;
                if (unitSRP <> 0.0 AND initialSalesCost <> 0.0) {
                    salesCostArray = float[] {
                        unitSRP,
                        initialSalesCost
                    };
                    //print 	"salesCostArray "; print salesCostArray ; 
                    finalSalesCost = min(salesCostArray);
                } elif (unitSRP == 0.0 AND initialSalesCost <> 0.0) {
                    finalSalesCost = initialSalesCost;
                } elif (unitSRP <> 0.0 AND initialSalesCost == 0.0 AND codePresent <> "true") {
                    finalSalesCost = unitSRP;

                }
                //END - Derivation of Unit Sales Cost//
                //START - Derivation of Unit Contracted Price//
                if ((businessLine_c == "ITS" AND modelnameforpart == "Equipment") OR (businessLine_c == "ITS" AND part_custom_field27 == "VP")) {
                    contractedPrice = unitSRP;
                } else {
                    contractedPrice = finalSalesCost * (1 + hardwareTargetPrice);

                    if (contractedPrice > unitSRP) {
                        contractedPrice = unitSRP;
                    }
                }
                if (codePresent == "true") {
                    contractedPrice = cashPrice;

                    unitSellingPrice = contractedPrice;
                    extSellingPrice = price_quantity * unitSellingPrice;
                    unitNetPrice = unitSellingPrice;
                    extnetsellprice = unitNetPrice * price_quantity;
                }
                if (businessLine_c == "ITS" OR businessLine_c == "PS" OR businessLine_c == "TRADITIONAL") {
                    if (unitSRP <> 0.0 AND contractedPrice <> 0.0) {
                        contractedPriceArray = float[] {

                            unitSRP,
                            contractedPrice
                        };
                        contractedPrice = min(contractedPriceArray);

                        unitSellingPrice = contractedPrice;
                        extSellingPrice = price_quantity * unitSellingPrice;
                        unitNetPrice = unitSellingPrice;
                        extnetsellprice = unitNetPrice * price_quantity;
                    } elif (unitSRP <> 0.0 AND contractedPrice == 0.0 AND codePresent <> "true") {
                        contractedPrice = unitSRP;
                        unitSellingPrice = contractedPrice;
                        extSellingPrice = price_quantity * unitSellingPrice;
                        unitNetPrice = unitSellingPrice;
                        extnetsellprice = unitNetPrice * price_quantity;
                    }
                }

                if (businessLine_c == "PS" OR businessLine_c == "TRADITIONAL") {
                    if (vendorQuoteNumber_VLIG <> "") {
                        contractedPrice = unitSRP;

                    } elif (unitSRP <> 0.0 AND contractedPrice <> 0.0 AND contractedPrice > unitSRP) {
                        contractedPriceArray = float[] {

                            unitSRP,
                            contractedPrice
                        };
                        contractedPrice = min(contractedPriceArray);
                    } elif (unitSRP <> 0.0 AND contractedPrice == 0.0 AND codePresent <> "true") {
                        contractedPrice = unitSRP;
                    }
                    unitSellingPrice = contractedPrice;
                    extSellingPrice = price_quantity * unitSellingPrice;
                    unitNetPrice = unitSellingPrice;
                    extnetsellprice = unitNetPrice * price_quantity;
                }
                stretchPrice = 0.0;
                stretchPrice = contractedPrice * (1 + stretchPriceUplift);
                roundStretchPrice = round(stretchPrice, 4);
                if (roundStretchPrice > unitSRP) {
                    roundStretchPrice = unitSRP;
                }

                // promotionjson = json();
                //promotionjsonarray = jsonarray();

                perfPassedPromoStr = "";
