                result = result + document_number + "~unitCost_l~" + string(roundUnitCost) + "|";
                result = result + document_number + "~unitSalesCost_l~" + string(roundSalesCost) + "|";
                result = result + document_number + "~contractedUnitPrice_l~" + string(roundContractedPrice) + "|";
                result = result + document_number + "~contractPrice_l~" + string(roundContractedPrice) + "|";
                result = result + document_number + "~targetPrice_l~" + string(roundHardwareTargetPrice) + "|";
                result = result + document_number + "~stretchPriceCurrency_c~" + string(roundStretchPrice) + "|";
                if (RsiTotalCondition == false AND ((discounttype_l == "" AND businessLine_c <> "TRADITIONAL") OR ((discountApplied == false OR (discountApplied == true AND ActionTrigger == "Before Formulas")) AND model_name == "" AND businessLine_c == "TRADITIONAL"))) {
                    result = result + document_number + "~marginPercentagesalescost_l~" + string(marginPercentagesalescost) + "|";
                    result = result + document_number + "~marginPercentagestdscost_l~" + string(marginPercentagestdscost) + "|";

