                    }
                }

                CashJson = json();
                priceQuantity_c = price_quantity;

                /*print "CONTRACTED_UI_FLG"; print CONTRACTED_UI_FLG;
                print "PropertyTaxUplift--"+ string(PropertyTaxUplift);
                print "LateFee_LeasePayment_Uplift--" + string(LateFee_LeasePayment_Uplift);
