                    // print part_number;
                    // print roundunitSellingPrice;
                    result = result + document_number + "~unitSellingPrice_l~" + string(roundunitSellingPrice) + "|";
                    result = result + document_number + "~extSellingPrice_l~" + string(roundextNetPrice) + "|";
                    result = result + document_number + "~unitNetPrice_l~" + string(roundunitNetPrice) + "|";
                    result = result + document_number + "~extNetPrice_l~" + string(roundextNetPrice) + "|";


