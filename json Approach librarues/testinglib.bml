                    if (waiveLateFee_c) {
                        WaiveLateFeeUplift = (1 + (1 * (waiveLeaseRatefactor / 100)));
                    }
                    LateFee_LeasePayment_Uplift = (WaiveLateFeeUplift + (WaiveLateFeeUplift * (LeasePaymentDeferralFactor / 100)));
                }
                modelBaseUnitCode = modelBaseUnitCode_c;
                if (isnumber(jsonpathgetsingle(TableQueryJson, "$.TablePayload.LeaseInfo." + part_number + ".MonthlyLeasePayment", "string"))) {
