                            CONTRACTED_UI_FLG = "False";
                        }
                    } elif (discountApplied == true) {
                        //  print 1026;
                        //  print part_number;
                        contractSellingPrice = unitNetPrice_l;
                        if (contracted_c == "Contract") {
                            CONTRACTED_UI_FLG = "True";
                        } elif (contracted_c == "Target") {
                            CONTRACTED_UI_FLG = "False";
                        }

                    }
                }
                //print "MonthlyLeasePayment*---"+string(MonthlyLeasePayment);
                if (contractSellingPrice > 0) {
                    if ((BOM_Item_Type == "Standard" AND businessLine_c == "TRADITIONAL") OR (businessLine_c == "PS" OR businessLine_c == "ITS")) {
