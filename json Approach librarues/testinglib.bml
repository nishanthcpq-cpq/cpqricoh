LookupQuerydata = bmql("select LOOKUP_CODE from RAC_SC_Lookup where  ((LOOKUP_TYPE ='RGC_DSP_VALUES' OR LOOKUP_TYPE ='ENT_SERV_CATEGORY_PORTFOLIO_CATEGORY' )  AND ENABLE_FLAG ='Y')");
for each in LookupQuerydata {
    Lookupvalue = get(each, "LOOKUP_CODE");
    LOOKUP_TYPE = get(each, "LOOKUP_TYPE");
    if (LOOKUP_TYPE == "RGC_DSP_VALUES") {
        if (findinarray(DSPValuesArray, Lookupvalue) == -1) {
            append(DSPValuesArray, Lookupvalue);
        }
    } else {
        if (findinarray(RGCPortfolioCategoryArray, Lookupvalue) == -1) {
            append(RGCPortfolioCategoryArray, Lookupvalue);
        }
    }
}


/*Start Changes done for ITS-RWA -Supriya*/
partItemIDJson = json();
if (modelsContainsInQuote <> "Managed Print Services") {
    // 01_03_2024 #CHG0085215 for MPS_Performance_Code_Changes_by_Vasundhara - Added if condition so that below code should not run for MPS
    if (find(modelsContainsInQuote, "XaaS") <> -1) {
        parentVarname = "XaaS";
    } elif (find(modelsContainsInQuote, "HWaaS") <> -1) {
        parentVarname = "Hwaas";
    } elif (find(modelsContainsInQuote, "Ricoh Process AP") <> -1) {
        parentVarname = "RPAP";
    }
    /*Set the Json-partItemIDJson to store Price related details from standard table-Oracle_BomItemDef2*/
    recordSet = bmql("select OracleSetName ,ItemId,PartNumber from Oracle_BomItemDef2 where ParentVariableName = $parentVarname");
    for eachRow in recordSet {
        ItemId = get(eachRow, "ItemId");
        partNumber = get(eachRow, "PartNumber");
        jsonput(partItemIDJson, partNumber, ItemId);
        jsonput(itemJSON, partNumber + get(eachRow, "OracleSetName"), ItemId);
    }
    /*End Changes done for ITS-RWA -Supriya*/
}


if (iTSPricingRuleResponse_c <> "") {
