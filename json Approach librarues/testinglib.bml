                    (part_custom_field27 == "VP" OR part_custom_field27 == "YES") AND (businessLine_c == "PS" OR businessLine_c == "ITS" OR businessLine_c == "TRADITIONAL") AND vendorQuoteNumber_VLIG == "")) AND
