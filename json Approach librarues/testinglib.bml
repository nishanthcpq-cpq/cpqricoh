                    jsonput(lineJSON, "extSellingPrice_l", roundextNetPrice);
                    jsonput(lineJSON, "unitNetPrice_l", roundunitNetPrice);
                    jsonput(lineJSON, "extNetPrice_l", roundextNetPrice);



