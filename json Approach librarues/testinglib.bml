            }
            //print "rACUserOrg_c "; print rACUserOrg_c ;print "TotalDealAmoun"; print TotalDealAmount ;

            if (acquisitionType_t == "Lease" AND TotalDealAmount > 0.0 AND rACUserOrg_c == "RCI" AND part_number <> "" AND (businessLine_c <> "TRADITIONAL" OR (businessLine_c == "TRADITIONAL" AND sellableItem_l_c) OR ((findinarray(HWModelLineArr, rowLine) <> -1) AND pricelistRateFlag_c))) { //Modified for CR100

                leaseRateStr = "";
                if ((businessLine_c == "ITS" OR businessLine_c == "PS") AND type_l <> "REFINANCE" AND businessLine_c <> "TRADITIONAL" AND leaseTypeList_c <> "LOAN") {
                    SoftCost_Flg = true;
                }
                if (USED_FLG) {
                    print "";
                    //	CHART_DERIVATION = CHART_DERIVATION_USED; //bmq_l("select * from LEASE_CHRT_DERIVATON where PRODUCT_TYPE = 'Used'  AND ORG = 'RCI'");
                } elif (SoftCost_Flg) {
                    CHART = softcostchart;
                    leaseRate1 = jsonget(leaseRateJSON, "Soft_Cost", "float", 0.00);
                } else {
                    //	CHART_DERIVATION = CHART_DERIVATION_NEWHD; //bmq_l("select * from LEASE_CHRT_DERIVATON where PRODUCT_TYPE = 'New HW' AND ORG = 'RCI' AND LEASE_TYPE = $leaseTypeList_c");
                    leaseRate1 = jsonget(leaseRateJSON, "New_HD", "float", 0.00);
                    CHART = NewHD;
                }
                if (leaseTypeList_c == "LOAN") {
                    CHART = "Chart2";
                    leaseRate = jsonget(leaseRateJSON, "Soft_Cost", "float", 0.00);
                }
                if (pricelistRateFlag_c) {
                    LeaseRate = PricelistLeaseRate;
                } elif (CHART <> "Based on %Air") {
                    // print CHART; print "CHART";
                    leaseRate = leaseRate1;
                    if (ApprovedLeaseRate) {
                        if (CHART == "Chart1") {
                            leaseRate = leasing_equipmentFMV_c;
                        } elif (CHART == "Chart2") {
                            leaseRate = leasing_BuyoutSoftCosts_c;
                        }
                    }
                } else {

                    leaseRate = softCostRate;
                }
            }
            if (leaseRate > 0.0) {
                jsonput(headerJSON, "softcostLeaseRate_c", leaseRate);
            } else {
                // setattributevalue(1, "softcostLeaseRate_c", 0.00);
                jsonput(headerJSON, "softcostLeaseRate_c", "0.00");

            }
            if (CONTRACTED_FLG == false OR part_number == "EFEE" OR part_number == "HDSTANDARD" OR isPickupAdded_c == true) {
                if (PropertyTax_Uplift > 0) {
                    leaseRate = leaseRate + PropertyTax_Uplift;
                }
                if (LateFee_LeasePayment_Uplift > 0) {
                    leaseRate = leaseRate * LateFee_LeasePayment_Uplift;
                }
                if (RsiTotalCondition == false) {
                    itemSellingPrice = unitNetPrice_l;
                } else {
                    itemSellingPrice = jsonget(RSISellingPriceJson, document_number, "float");

                }
                // print "itemSellingPrice ";
                // print itemSellingPrice;
                // print ActionTrigger;
                MonthlyPayment = itemSellingPrice * leaseRate;
                unitLeasePayment = MonthlyPayment;
                leasePayment = MonthlyPayment * price_quantity;

                //print "MonthlyPayment--"+string(MonthlyPayment);
                if (leaseBillingFrequency_c == "Quarterly") {
                    MonthlyPayment = (MonthlyPayment / 3);
                }
                if (leaseBillingFrequency_c == "Semi-Annually") {
                    MonthlyPayment = (MonthlyPayment / 6);
                }
                if (leaseBillingFrequency_c == "Annually") {
                    MonthlyPayment = (MonthlyPayment / 12);
                }
                //added by Namrata defect 34268 in 2.0
                MonthlyPayment = round(MonthlyPayment, 2);
                extMonthlyPayment = MonthlyPayment * price_quantity;
                //END_DESC added as part of CR-67 part of 2.0
                print 2272;
                print part_number;
                print leaseRate;
                print MonthlyPayment;
                if (itemIdentifier_c == "BASE UNIT") {
                    jsonput(BaseUnitJson, BaseUnitLine + "+" + "leaseRate_c", leaseRate);
                }
                if (RsiTotalCondition == false AND sellableItem_l_c AND part_custom_field18 <> "OKS-SUBSCRIPTION-STANDALONE" AND chargeType_l <> "Recurring" AND model_variable_name == "" AND ((parent_doc_number <> TSModelLine AND TSModelLine <> "") OR TSModelLine == "") //AND discountApplied =  = false
                ) {
                    print "Hell 2283";
                    print part_number;

                    jsonput(lineJSON, "monthlyPayment_c", monthlyPayment);
                    jsonput(lineJSON, "extMonthlyPayment_c", extMonthlyPayment);

                    jsonput(lineJSON, "leasePayment_c", leasePayment);
                    jsonput(lineJSON, "unitLeasePaymentLine_c", unitLeasePayment);

                }

                if (sellableItem_l_c AND RsiTotalCondition == false AND part_custom_field18 <> "OKS-SUBSCRIPTION-STANDALONE" AND chargeType_l <> "Recurring" AND model_variable_name == "" AND ((parent_doc_number <> TSModelLine AND TSModelLine <> "") OR TSModelLine == "") // AND discountApplied =  = false
                ) {
                    jsonput(lineJSON, "leaseRate_c", leaseRate);
                }
                if ((part_custom_field18 == "OKS-SUBSCRIPTION-STANDALONE" OR chargeType_l == "Recurring") AND RsiTotalCondition == false) {

                    jsonput(lineJSON, "monthlyPayment_c", round(itemSellingPrice, 2));
                    jsonput(lineJSON, "extMonthlyPayment_c", itemSellingPrice * price_quantity);
                }
            }
        }
        //  print "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%";



        // 3rd tranaction loop   start

        docNum = document_number;

        linkedItem_l = jsonget(lineJSON, "linkedItem_l", "string", "");

        partDescriptionOnProposal_l = jsonget(lineJSON, "partDescriptionOnProposal_l", "string", "");
        model_product_line_name = jsonget(lineJSON, "_model_product_line_name", "string", "");
        modelName_l_c = jsonget(lineJSON, "modelName_l_c", "string", "");
        modelName_l_c = jsonget(lineJSON, "modelName_l_c", "string", "");

        // PS LINKAGE Nestead Json for HARDWARE 
        psLikageJson = json();
        if (linkedItem_l <> "") {

            jsonput(psLikageJson, "linked_qot_line_id", group_sequence_number);
            jsonput(psLikageJson, "linked_edp_code", part_number);
            jsonput(psLikageJson, "linked_quantity", price_quantity);
            jsonput(psLikageJson, "linked_description", partDescriptionOnProposal_l);
            jsonput(psLikageJson, "linked_to_line_no", linkedItem_l);

            //jsonarrayappend(pSlinkageJsonArry,psLikageJson);
            result = result + docNum + "~pSLinkageFlag_c~" + string(true) + "|";
            jsonput(pSlikageMainJson, "linkedItems", psLikageJson);
            result = result + document_number + "~pSLinkageLineJsonTextArea_c~" + jsontostr(pSlikageMainJson) + "|";
        }

        // to delete EFEE lines if not applicable
        headerDict = dict("string");
        put(headerDict, "Content-Type", "application/json");
        if (EnvtFee_FLAG == false AND (part_number == "EFEE")) {
            docNumber = document_number;
            // Storing the document number to trigger the bulk API
            selectionvalue = "transactionLine/" + docNumber;
            jsonarrayappend(selectionjsonarray, selectionvalue);
        }

        // to delete EFEE lines if not applicable

        if (containskey(ENVT_FEE_Parent, document_number) AND NOT pricelistRateFlag_c) {
            if (findinarray(linkedLineArr, group_sequence_number) == -1 AND RunEFEE == "True") {
                value = group_sequence_number;
                qty = atof(get(ENVT_FEE_Qty, group_sequence_number));
                /* print "RunEFEE";
                 print RunEFEE;*/
                eDPCodeJson1 = json();
                partsArray1 = jsonarray();
                jsonput(eDPCodeJson1, "partNumber", "EFEE");
                jsonput(eDPCodeJson1, "quantity", (qty));
                jsonput(eDPCodeJson1, "linkedItem_l", value);
                jsonput(eDPCodeJson1, "linkedLineDocumentNumber_l_c", document_number); // Storing the document number for reference
                EHF_CHARGE = get(ENVT_FEE_Price, value);
                if (EHF_CHARGE <> "" AND not(isnull(EHF_CHARGE))) {
                    MonthlyPayment = 0.0;
                    extMonthlyPayment = 0.0;
                    leaseRate = 0.0;
                    EHF_CHARGE_Float = atof(EHF_CHARGE);
                }
                ExtPrice = get(ENVT_FEE_ExtPrice, value);
                if (ExtPrice <> "" AND not(isnull(ExtPrice))) {
                    ExtPrice_Float = atof(ExtPrice);
                }
                jsonput(eDPCodeJson1, "unitSRP_l", EHF_CHARGE_Float);
                jsonput(eDPCodeJson1, "extSRP_l", EHF_CHARGE_Float * qty);
                jsonput(eDPCodeJson1, "unitSalesCost_l", EHF_CHARGE_Float);
                jsonput(eDPCodeJson1, "unitCost_l", EHF_CHARGE_Float);
                jsonput(eDPCodeJson1, "contractedUnitPrice_l", EHF_CHARGE_Float);
                jsonput(eDPCodeJson1, "contractPrice_l", EHF_CHARGE_Float);
                jsonput(eDPCodeJson1, "unitSellingPrice_l", EHF_CHARGE_Float);
                jsonput(eDPCodeJson1, "extSellingPrice_l", EHF_CHARGE_Float * qty);
                //roundoff  for defect 34268
                jsonput(eDPCodeJson1, "unitNetPrice_l", round(EHF_CHARGE_Float, 2));
                jsonput(eDPCodeJson1, "extNetPrice_l", round(EHF_CHARGE_Float, 2) * qty);
                //Added by Chandra to set GP% for EFEE lines
                jsonput(eDPCodeJson1, "marginPercentagestdscost_l", 0.0);
                jsonput(eDPCodeJson1, "marginPercentagesalescost_l", 0.0);
                jsonarrayappend(partsArray1, eDPCodeJson1);
                resultArray1 = addpartstotransaction(partsArray1, "_default_price_book");
                //print "EDPCodePartAddition";
                //print eDPCodeJson1;
            }
        }
        // Added for CR 064 Start ----->
        if ((model_product_line_name == "Multifunction Color" OR model_product_line_name == "Multifunction B&W") AND (findinarray(linkedLineArr, group_sequence_number) == -1)) {

            if (findinarray(pricelistArr, combinedPriceListMenu_c) == -1) {
                eDPCodeJson2 = json();
                partsArray2 = jsonarray();
                jsonput(eDPCodeJson2, "partNumber", "MFP-TRAIN-VIRTUAL");
                jsonput(eDPCodeJson2, "quantity", 1);
                jsonput(eDPCodeJson2, "linkedItem_l", group_sequence_number);
                jsonput(eDPCodeJson2, "linkedLineDocumentNumber_l_c", document_number);
                jsonput(eDPCodeJson2, "unitSRP_l", 0.0);
                jsonput(eDPCodeJson2, "extSRP_l", 0.0);
                jsonput(eDPCodeJson2, "unitSalesCost_l", 0.0);
                jsonput(eDPCodeJson2, "unitCost_l", 0.0);
                jsonput(eDPCodeJson2, "contractedUnitPrice_l", 0.0);
                jsonput(eDPCodeJson2, "contractPrice_l", 0.0);
                jsonput(eDPCodeJson2, "unitSellingPrice_l", 0.0);
                jsonput(eDPCodeJson2, "extSellingPrice_l", 0.0);
                jsonput(eDPCodeJson2, "unitNetPrice_l", 0.0);
                jsonput(eDPCodeJson2, "extNetPrice_l", 0.0);
                jsonput(eDPCodeJson2, "marginPercentagestdscost_l", 0.0);
                jsonput(eDPCodeJson2, "marginPercentagesalescost_l", 0.0);
                jsonarrayappend(partsArray2, eDPCodeJson2);
                resultArray2 = addpartstotransaction(partsArray2, "_default_price_book");
                //print "EDPCodePartAddition";
                //print eDPCodeJson2;
            }
        }
        // 3rd tranactionloop  end
        jsonarrayappend(linesJArray, lineJSON);
    }
    jsonput(lineDetailsJSON, "lineDetails", linesJArray);
    jsonput(lineDetailsJSON, "header", headerJSON);

}
if (federalFlg == true) {
    result = result + "1~federalFlg_c~FEDERAL|";
}
// Invoking the bulk API to delete the lines
if (jsonarraysize(selectionjsonarray) > 0) {
    paramJson = json();
    jsonput(paramJson, "selections", selectionjsonarray);
    jsonput(paramJson, "bs_id", bs_id);
    removeTransactionsJson = util.removeTransactionLineAPI(paramJson);
}
jsonput(pSlikageMainJson, "linkedItems", pSlinkageJsonArry);
result = result + "1~pSLinkageJsonTextArea_c~" + jsontostr(pSlikageMainJson) + "|";
//print "Final output Library";
print result;

return lineDetailsJSON;