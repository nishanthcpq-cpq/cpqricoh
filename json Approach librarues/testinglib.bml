                            for each in arraysizeAddress {
                                LocationID = jsonget(json(jsonarrayget(customerAccountResult_t, each)), "locationSiteID_Result_t");
                                if (LocationID == locationSiteID_l) {
                                    province = jsonget(json(jsonarrayget(customerAccountResult_t, each)), "state_Result_t");
                                }
                            }
                        }
                        //print "State";print province;  
                        // efee , its-mfp vritual          
