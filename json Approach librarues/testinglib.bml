                            partNumber = part_number;
                            // for Re in Records_RCI_ENVT_FEE {
                            // EHF_CHARGE = get(Re, "EHF_CHARGE");
                            if (jsonpathcheck(ReJSON, "$." + part_number + province + "EHF_CHARGE")) {
                                EHF_CHARGE = jsonget(ReJSON, part_number + province + "EHF_CHARGE", "string", "");

                                activeStartDateInNumber = 0;
                                activeStartDateInStr = "";
                                activeStartDate = getdate();
                                activeStartDateStrArr = string[];
                                // activeStartDatewithTimeStamp = get(Re, "ACTIVE_START_DATE");
                                if (jsonpathcheck(ReJSON, "$." + part_number + province + "ACTIVE_START_DATE")) {
                                    activeStartDatewithTimeStamp = jsonget(ReJSON, part_number + province + "ACTIVE_START_DATE", "string", "");
                                }
                                currentDatewithTimeStamp = getstrdate();
                                //currentDate = getstrdate();
                                currentDateStrArr = split(currentDatewithTimeStamp, " ");
                                currentDate = strtojavadate(datetostr(strtojavadate(currentDateStrArr[0], "MM/dd/yyyy"), "MM-dd-yyyy"), "MM-dd-yyyy");

                                activeStartDatewithTimeStamp = "";
                                if (activeStartDatewithTimeStamp <> "") {
                                    activeStartDateStrArr = split(activeStartDatewithTimeStamp, " ");
                                    activeStartDateInStr = activeStartDateStrArr[0];
                                    activeStartDate = strtojavadate(activeStartDateInStr, "MM-dd-yyyy");
                                }
                                // print activeStartDate ;print activeStartDateInStr ;
                                activeEndDateInNumber = 0;
                                activeEndDateInStr = "";
                                activeEndDate = getdate();
                                // activeEndDatewithTimeStamp = get(Re, "ACTIVE_END_DATE");
                                activeEndDatewithTimeStamp = "";
                                if (jsonpathcheck(ReJSON, "$." + part_number + province + "ACTIVE_END_DATE")) {
                                    activeEndDatewithTimeStamp = jsonget(ReJSON, part_number + province + "ACTIVE_END_DATE", "string", "");
                                }

                                //print activeEndDatewithTimeStamp ;
                                if (activeEndDatewithTimeStamp <> "") {

                                    activeEndDateStrArr = split(activeEndDatewithTimeStamp, " ");
                                    activeEndDateInStr = activeEndDateStrArr[0];
                                    activeEndDate = strtojavadate(activeEndDateInStr, "MM-dd-yyyy");
                                }
                                compareStartAndCurrentDate = comparedates(activeStartDate, currentDate);
                                compareCurrentAndEndDate = comparedates(currentDate, activeEndDate);
                                pickThisRecord = false;
                                if (activeStartDateInStr <> "" AND activeEndDateInStr <> "" AND (compareStartAndCurrentDate == -1 OR compareStartAndCurrentDate == 0) AND (compareCurrentAndEndDate == -1 OR compareCurrentAndEndDate == 0)) {
                                    pickThisRecord = true;
                                } elif (activeStartDateInStr <> "" AND activeEndDateInStr == "" AND (compareStartAndCurrentDate == -1 OR compareStartAndCurrentDate == 0)) {
                                    pickThisRecord = true;
                                }
                                if (pickThisRecord) {
                                    put(ENVT_FEE_Price, group_sequence_number, EHF_CHARGE);
                                    if (EHF_CHARGE <> "" AND not(isnull(EHF_CHARGE))) {
                                        put(ENVT_FEE_ExtPrice, group_sequence_number, string(atof(EHF_CHARGE) * price_quantity));
                                    }
                                    put(ENVT_FEE_Qty, group_sequence_number, string(price_quantity));
                                    put(ENVT_FEE_Parent, document_number, "True");
                                    append(ENVT_FEE_Item_Arr, group_sequence_number);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    jsonarrayappend(linesJArray, lineJSON);
}
jsonput(lineDetailsJSON, "lineDetails", linesJArray);

leaseRateJSON = json();

if (iSRGCPricingApprovalCompleted_c == false) {
    ThresholdValue = 0.0;
    if (RGCUnitNetPrice > 0.0) {
        ThresholdValue = ((RGCUnitNetPrice - RGCUnitSalesCost) / RGCUnitNetPrice) * 100;
    }
    if (acquisitionType_t <> "Dealer") {
        PricingQueryData = bmql("select * from RAC_Approval_Matrix");
        for each in PricingQueryData {
            minThreshold = get(each, "MinThreshold");
            maxThreshold = get(each, "Threshold_MaxOrEqual");

            if (ThresholdValue > atof(minThreshold) AND ThresholdValue <= atof(maxThreshold)) {
                Message = get(each, "MessageText");
                result = result + "1~warningMessageForRGCPricingThresholdTextArea_t_c~" + Message + "|" + "1~flagForRGCPricing_c~" + string(true) + "|" + "1~rGCGPSalesCostPercentage_c~" + string(ThresholdValue) + "|";
                break;
            }
        }
    }
}
if (Message == "") {
    result = result + "1~warningMessageForRGCPricingThresholdTextArea_t_c~" + Message + "|" + "1~flagForRGCPricing_c~" + string(false) + "|" + "1~rGCGPSalesCostPercentage_c~" + string(ThresholdValue) + "|";
    jsonput(headerJSON, "warningMessageForRGCPricingThresholdTextArea_t_c", Message);
    jsonput(headerJSON, "flagForRGCPricing_c", false);
    jsonput(headerJSON, "rGCGPSalesCostPercentage_c", ThresholdValue);


