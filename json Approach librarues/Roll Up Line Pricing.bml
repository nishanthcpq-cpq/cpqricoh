			modelcontractedUnitPricePrice = jsonpathgetsingle(lineDetailsJSON, contractedUnitPricePath + ".sum()", "float", 0.0);
			//modelListPrice = jsonpathgetsingle(lineDetailsJSON, listPricePath + ".sum()", "float", 0.0);
