// This function will only roll up models. No header level or bottom of the hierarchy pricing should be here
lineDetailsJSON = inputJSON;
debug = jsonget(inputJSON, "debug", "boolean", false);
if (debug) {
	params = json();
	lineDetailsJSON = commerce.getQuoteData_c(jsontostr(params));
}
pIOFlag = jsonpathgetsingle(lineDetailsJSON, "$.header.pIO_t_c", "boolean", false);
modelJsonPath = "$..lineDetails[?(@._model_variable_name != '')]._document_number";
modelDocNumbers = jsonarray();
if (jsonpathcheck(lineDetailsJSON, modelJsonPath)) {
	modelDocNumbers = jsonpathgetmultiple(lineDetailsJSON, modelJsonPath);
}
if (jsonarraysize(modelDocNumbers) > 0) {
	indexes = range(jsonarraysize(modelDocNumbers));

	for i in indexes {
		modelDocNumber = jsonarrayget(modelDocNumbers, i);

		path = "$..lineDetails[?(@._document_number == '" + modelDocNumber + "')]";
		modelLineJSON = jsonpathgetsingle(lineDetailsJSON, path, "json");

		//modelGroupSeq = jsonpathgetsingle(lineDetailsJSON, "$..lineDetails[?(@._document_number == '" + modelDocNumber + "')]._group_sequence_number", "string", "");
		//modelGroupSeq = jsonget(lineDetailsJSON, "_group_sequence_number", "string", "");
		//modelGroupSeq = jsonget(modelLineJSON, "_group_sequence_number", "string", "");
		modelGroupSeq = jsonpathgetsingle(lineDetailsJSON, path + "._group_sequence_number", "string", "");
		
		itemtype =  jsonpathgetsingle(lineDetailsJSON, path + ".type_l", "string", "");
		//print itemtype  ;
		modelGroupSeqArr = split(modelGroupSeq, ".");
		modelGroupSeqNo = modelGroupSeqArr[0];
		//print modelGroupSeqNo;
		//childItemPath = "$..lineDetails[?(@._group_sequence_number =~ /" + modelGroupSeqNo + ".*?/i && @._model_variable_name == '')]"; // to eliminitae  PS - Items
		childItemPath = "$..lineDetails[?(@._group_sequence_number =~ /" + modelGroupSeqNo + ".*?/i && @._model_variable_name == '' && @.type_l == '"+ itemtype  +"' )]";
		//childItemPath = "$..lineDetails[?(@._group_sequence_number =~ /" + modelGroupSeqNo + ".*?/i && @._model_variable_name == '' && @.type_l == 'HARDWARE' )]";

		//print childItemPath ;
		//variables       
		modelListPrice = 0.0;
		modelNetPrice = 0.0;
		modelNetAmount = 0.0;
		modelTotalPrice = 0.0;
		modelunitSRPPrice = 0.0;
		modelextSRPPrice = 0.0;
		modelunitSalesCostPrice = 0.0;
		modelcontractedUnitPricePrice = 0.0;
		modelstretchPriceCurrencyPrice = 0.0;
		modelunitSellingPricePrice = 0.0;
		modelextSellingPricePrice = 0.0;
		modelEXTNetPrice = 0.0;
		modelNetAmount = 0.0;

		//UnitSrp Price       
		unitSRPpath = childItemPath + ".unitSRP_l";
