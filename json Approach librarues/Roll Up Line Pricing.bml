					modelTotalPrice = jsonpathgetsingle(lineDetailsJSON, totalPricePath + ".sum()", "float", 0.0); 
				} */
marginSalesCost  = 0.00 ; marginStandardCost  = 0.00 ;

			if(modelNetAmount  <> 0.00 ){
			marginSalesCost = ((modelNetAmount - modelunitSalesCostPrice ) / modelNetAmount ) * 100;
			marginStandardCost = ((modelNetAmount - modelnetunitcostAmount ) / modelNetAmount) * 100;
			}
			
		// Roll up calculated prices to the model line
		jsonpathset(lineDetailsJSON, path + ".unitSRP_l", modelunitSRPPrice);
		jsonpathset(lineDetailsJSON, path + ".extSRP_l", modelextSRPPrice);
		jsonpathset(lineDetailsJSON, path + ".unitSalesCost_l", modelunitSalesCostPrice);
		jsonpathset(lineDetailsJSON, path + ".contractedUnitPrice_l", modelcontractedUnitPricePrice);
		jsonpathset(lineDetailsJSON, path + ".stretchPriceCurrency_c", modelstretchPriceCurrencyPrice);
		jsonpathset(lineDetailsJSON, path + ".unitSellingPrice_l", modelunitSellingPricePrice);
		jsonpathset(lineDetailsJSON, path + ".extSellingPrice_l", modelextSellingPricePrice);
		jsonpathset(lineDetailsJSON, path + ".extNetPrice_l", modelEXTNetPrice);
		jsonpathset(lineDetailsJSON, path + ".unitNetPrice_l", modelNetAmount);
		jsonpathset(lineDetailsJSON, path + ".unitCost_l", modelnetunitcostAmount);
		
		jsonpathset(lineDetailsJSON, path + ".marginPercentagesalescost_l", marginSalesCost);
		jsonpathset(lineDetailsJSON, path + ".marginPercentagestdscost_l", marginStandardCost);

