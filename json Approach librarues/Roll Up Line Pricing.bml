		if (jsonpathcheck(lineDetailsJSON, ExtnetPricePath)) {
			modelEXTNetPrice = jsonpathgetsingle(lineDetailsJSON, ExtnetPricePath + ".sum()", "float", 0.0);
			//modelNetPrice = jsonpathgetsingle(lineDetailsJSON, ExtnetPricePath + ".sum()", "float", 0.0);
		}
		//UnitNet Amount        
		netAmountPath = childItemPath + ".unitNetPrice_l";
		if (jsonpathcheck(lineDetailsJSON, netAmountPath)) {
			modelNetAmount = jsonpathgetsingle(lineDetailsJSON, netAmountPath + ".sum()", "float", 0.0);
			//modelNetAmount = jsonpathgetsingle(lineDetailsJSON, netAmountPath + ".sum()", "float", 0.0);
		}
				netunitcostPath = childItemPath + ".unitCost_l";
		if (jsonpathcheck(lineDetailsJSON, netAmountPath)) {
			modelnetunitcostAmount = jsonpathgetsingle(lineDetailsJSON, netunitcostPath + ".sum()", "float", 0.0);
