			//modelListPrice = jsonpathgetsingle(lineDetailsJSON, listPricePath + ".sum()", "float", 0.0);
			//print jsonpathgetmultiple(lineDetailsJSON, extSellingPricePath);
		}



		/*
				//List Price       
				listPricePath = childItemPath + ".listPrice_l";
				if (jsonpathcheck(lineDetailsJSON, listPricePath)) {
					modelListPrice = jsonpathgetsingle(lineDetailsJSON, listPricePath + ".sum()", "float", 0.0);
					//modelListPrice = jsonpathgetsingle(lineDetailsJSON, listPricePath + ".sum()", "float", 0.0);
					//print jsonpathgetmultiple(lineDetailsJSON, listPricePath);
