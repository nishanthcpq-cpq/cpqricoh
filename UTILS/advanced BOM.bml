removeOrphanedParents = jsonpathgetmultiple(fullBOM ,"$..children[?(@.definition.ItemType == 'Option Class')]");
//print removeOrphanedParents ;
rIndexes = range(jsonarraysize(removeOrphanedParents));
for i in rIndexes {
	removeOrphanedParent= jsonarrayget(removeOrphanedParents,i ,"json");
	//print removeOrphanedParent;
	partNumber = jsonget(removeOrphanedParent,"partNumber","string","");
	children = jsonget(removeOrphanedParent,"children","jsonarray");
	itemType = jsonpathgetsingle(removeOrphanedParent,"$.definition.ItemType","string");
	//print jsonpathgetsingle(temp ,removePath ,"json");
	print partNumber ;
	print jsonarraysize(children);
	print itemType ;
	if(jsonarraysize(children) == 0 and itemType == "Option Class"){
		removePath = "$..children[?(@.partNumber == '"+partNumber +"')]";
		jsonpathremove(fullBOM ,removePath);
	}
}
