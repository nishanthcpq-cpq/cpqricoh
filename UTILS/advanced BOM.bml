	}

//}
//print OrgItemStatusDict ;
for rec in recordSet {

    substreffectFrom = substring(get(rec, "EffectiveFrom"), 0, 10);
    //print substreffectFrom;
    substreffectTo =  substring(get(rec, "EffectiveTo"), 0, 10);
    //print substreffectTo;
   /*if (NOT util.validateDates(get(rec, "EffectiveFrom"), get(rec, "EffectiveTo"), getdate())) {
       continue;
   }*/
   // Fix for same effectivefrom and effectiveto date issue
   if (NOT util.validateDates(substreffectFrom, substreffectTo, getdate())) {
       continue;
   }

    ptNumber = get(rec, "PartNumber");
    parentVariableName = get(rec, "ParentVariableName");
	//if(bundleItemPath <> ""){
		if(parentVariableName <> "" and (NOT containskey(itemStatusDict,ptNumber)
			OR (containskey(itemStatusDict,ptNumber) and get(itemStatusDict,ptNumber) <> "Active"))){

			print ptNumber+"==="+get(itemStatusDict,ptNumber);
			continue;
		}
		if(containskey(orgNameDict ,ptNumber)){
			itemOrgName = get(orgNameDict ,ptNumber);
			checkOrg = (OrgName == "" OR itemOrgName == "" OR itemOrgName == "ALL"
					OR itemOrgName ==  "NONE" OR itemOrgName ==  OrgName);
			if(NOT checkOrg ){
				print 	ptNumber+"==="+itemOrgName ;
				continue;
			}
			if(checkOrg and itemOrgName <> "" and Serial_Number ==""){ // 10-03-2026 CHG0105953 by gandeev added and Serial_Number ==""
				checkKey = itemOrgName +"#"+ ptNumber +"#RUS";
				if(containskey(OrgItemStatusDict,checkKey) and OrgName == "RUS"){
					orgItemStatus = get(OrgItemStatusDict,checkKey);
					if(NOT isnull(orgItemStatus) and orgItemStatus <> "null" and UPPER(orgItemStatus) <> "ACTIVE"){
						continue;
					}
				}
				checkKey = itemOrgName +"#"+ ptNumber +"#RCI";
				if(containskey(OrgItemStatusDict,checkKey) and OrgName == "RCI"){
					OrgItemStatus = get(OrgItemStatusDict,checkKey);
					if(NOT isnull(orgItemStatus) and orgItemStatus <> "null" and UPPER(orgItemStatus) <> "ACTIVE"){
						continue;
					}
				}

			}
		}

	//}
    ItemType = get(rec, "ItemType");
    optional = get(rec, "Optional");
    id = get(rec, "VariableName");
    //print id ;

    rootVariableName = get(rec, "RootVariableName");
    ///OriginalRoot = get(rec, "OriginalRoot");
    defaultQuantity = getFloat(rec, "DefaultQuantity");
    startDate = get(rec, "EffectiveFrom");
    endDate = get(rec, "EffectiveTo");
    modelPath = get(rec, "ModelPath");
    componentCode = get(rec, "ComponentCode");

    if (upper(ItemType) == "ROOT" and (parentVariableName == "" OR isnull(parentVariableName))) {

        jsonput(mastrJson, "partNumber", ptNumber);
        jsonput(mastrJson, "quantity", "1");
        jsonput(mastrJson, "explodedQuantity", "1");
        jsonput(mastrJson, "id", id);
        jsonput(mastrJson, "isModel", true);
        jsonput(mastrJson, "variableName", id);
        jsonput(mastrJson, "parentId", "");
        jsonput(mastrJson, "configurablePrice", 0);
        jsonput(mastrJson, "Description", "");



        jsonput(mastrJson, "children", jsonarray());

        fieldsJson = json();
        jsonput(fieldsJson, "componentCode_l_c", "");
        jsonput(fieldsJson, "restLineFlag_c", false);
        if(Serial_Number <> ""){  //Added for Seasoned model and Serial number in Config comments
            jsonput(fieldsJson, "configCommentsNew_l", "Seasoned - #"+ Serial_Number );
            jsonput(fieldsJson, "modelName_l_c", "Seasoned Product");
	    jsonput(fieldsJson, "serialNumber_l_c", Serial_Number);
	    jsonput(fieldsJson, "warehouse_SeasonedProduct_l_c", WareHouse);
	    jsonput(fieldsJson, "_is_line_item_mandatory", true);

        }else{
        	        jsonput(fieldsJson, "modelName_l_c", "Hardware");


        }
       jsonput(mastrJson, "fields", fieldsJson);

       /*Defect #32913*/
       attributes = json();

       edpCodeDesc = json();
       jsonput(edpCodeDesc ,"value",mainUnitEDPCode);
       jsonput(edpCodeDesc ,"displayValue",mainUnitDesc);
       jsonput(edpCodeDesc ,"label",mainUnitDesc);

       jsonput(attributes ,"EquipmentModel",edpCodeDesc);
       jsonput(mastrJson, "attributes", attributes );
       /*Defect #32913*/

    } else {
        childjson = json();
        jsonput(childjson, "partNumber", ptNumber);
        defaultQuantity = 1;

	defaultQuantityArr = jsonpathgetmultiple(attributeValJSON,"$.BOM[?(@.itemPath == '"+id+"' )].quantity");
	//print "defaultQuantityArr";
	//print defaultQuantityArr;
	//print attributeValJSON;
	if(jsonarraysize(defaultQuantityArr) > 0){
		defaultQuantity = jsonarrayget(defaultQuantityArr,0,"integer");
		if(defaultQuantity == 0){
			defaultQuantity = 1;
		}
	}
	//print "ididid"+id;
	//print defaultQuantity ;

	jsonput(childjson, "quantity", defaultQuantity);

        jsonput(childjson, "id", id);
        jsonput(childjson, "variableName", id);
        jsonput(childjson, "parentId", parentVariableName);
        jsonput(childjson, "isModel", false);
        jsonput(childjson, "startDate", startDate);
        jsonput(childjson, "endDate", endDate);

        defJson = json();
        jsonput(defJson, "SequenceNum", 0);
		jsonput(defJson, "ItemType", ItemType);
        jsonput(defJson, "ItemId", id);
        jsonput(childjson, "definition", defJson);

        fieldsJson = json();
        jsonput(fieldsJson, "componentCode_l_c", componentCode);
	if(Serial_Number <> ""){  //Added for Seasoned model and Serial number in Config comments
            jsonput(fieldsJson, "configCommentsNew_l", "Seasoned - #"+ Serial_Number );
            jsonput(fieldsJson, "modelName_l_c", "Seasoned Product");
            jsonput(fieldsJson, "serialNumber_l_c", Serial_Number);
            jsonput(fieldsJson, "warehouse_SeasonedProduct_l_c", WareHouse);
 	    jsonput(fieldsJson, "_is_line_item_mandatory", true);

        }else{
        	        jsonput(fieldsJson, "modelName_l_c", "Hardware");


        }

        jsonput(childjson, "fields", fieldsJson);
        jsonarrayappend(childArr, childjson);



    }
}

jsonput(mastrJson, "children", childArr);
//print mastrJson;
fullBOM = convertbomtohier(mastrJson);
