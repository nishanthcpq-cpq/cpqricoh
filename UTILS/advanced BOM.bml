childArr = jsonarray();
mastrJson = json();
itemStatusDict = dict("string");
orgNameDict = dict("string");
OrgItemStatusDict = dict("string");
print selectedItemsArr;
recordSet = bmql("SELECT * FROM Oracle_BomItemDef2 WHERE (ParentVariableName IS NULL and RootVariableName = $modelNameU) OR  (RootVariableName = $modelNameU and VariableName in $selectedItemsArr) OR (RootVariableName = $modelNameU and (ParentVariableName like $bundle OR VariableName like $bundle1)) OR (RootVariableName = $modelNameU and PartNumber = $SUSItem)");// 10-03-2026 CHG0105953 by gandeev added  OR (RootVariableName = $modelNameU and PartNumber = $SUSItem)

//print recordSet ;
//if(bundleItemPath <> ""){
	EDPCodes = string[];
	for rec in recordSet {
		substreffectFrom = substring(get(rec, "EffectiveFrom"), 0, 10);
		//print substreffectFrom;
		substreffectTo =  substring(get(rec, "EffectiveTo"), 0, 10);

	   if (NOT util.validateDates(substreffectFrom, substreffectTo, getdate())) {
		   continue;
	   }
	   ptNumber = get(rec, "PartNumber");
	   append(EDPCodes,ptNumber);
	}

	partsRecordSet = bmql("select part_number ,custom_field1,custom_field326,custom_field337,custom_field338 from _parts where part_number in $EDPCodes");
	for partRec in partsRecordSet{
		put(itemStatusDict,get(partRec ,"part_number"),get(partRec ,"custom_field1"));
		put(orgNameDict ,get(partRec ,"part_number"),get(partRec ,"custom_field326"));
		put(OrgItemStatusDict ,get(partRec ,"custom_field326") +"#"+ get(partRec ,"part_number")+"#RUS",get(partRec ,"custom_field337"));
