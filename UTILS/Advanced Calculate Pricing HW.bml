print " suresh debbigging start ";

t_pricing_perf = getCurrentTimeInMillis();

lineDetailsJSON = pricingDocument;
//if(_supplier_company_name <> ""){
//lineDetailsJSON = json(_supplier_company_name);
//}                                                                                                                                    
fyCustomerStartType = jsonget(lineDetailsJSON, "fYCustomerStartType_c", "string", ""); //fYCustomerStartType_c;
//fyCustomerStartTypeException = jsonget(lineDetailsJSON, "rebatepercentage_Input_c", "string", ""); //fYStartCustomerTypeException_t;
fYStartProductionZBA = jsonget(lineDetailsJSON, "fYStartProductionZBA_c", "string", ""); //fYStartProductionZBA_c;
customerSegment = jsonget(lineDetailsJSON, "customerSegment_c", "string", "");
combinedPriceListMenu = jsonget(lineDetailsJSON, "combinedPriceListMenu_c", "string");
rebatePercentage = 0.0;
rebatePercentage = jsonget(lineDetailsJSON, "rebatepercentage_Input_c", "float", 0.00);
//rebatePercentage = rebatePercentage /100 ;
//print rebatePercentage ;
lines = jsonget(lineDetailsJSON, "lines", "jsonarray");
edpCodesJSONArray = jsonpathgetmultiple(lineDetailsJSON, "$..lines[?(@._partNumber != '')]._partNumber");
edpCodesArr = util.convertJSONArrayToStringArray(edpCodesJSONArray);

priceUpliftJSONArray = jsonpathgetmultiple(lineDetailsJSON, "$..lines[?(@.rCIPriceUpliftCategory_c != '')].rCIPriceUpliftCategory_c");
priceUpliftArr = util.convertJSONArrayToStringArray(priceUpliftJSONArray);
upliftdict = dict("string");
cashpricedict = dict("string");
SMAdict = dict("string");
currentDatewithTimeStamp = getstrdate();
currentDateStrArr = split(currentDatewithTimeStamp, " ");
currentDate = strtojavadate(datetostr(strtojavadate(currentDateStrArr[0], "MM/dd/yyyy"), "MM-dd-yyyy"), "MM-dd-yyyy");

/*********Query RAC_PL_CASH Data table****/
priceListRecordSet1 = bmql("select CashPrice,SMA, ActiveStartDate, ActiveEndDate, EDPCode,FPLAFlag , LeaseBasisPrice from RAC_PL_CASH where PriceListName = $combinedPriceListMenu AND EDPCode in $edpCodesArr AND ActiveFlag = 'Y'");
for eachRow in priceListRecordSet1 {

	startDateStr = get(eachRow, "ActiveStartDate");
	endDateStr = get(eachRow, "ActiveEndDate");
	isActive = true;
	if (startDateStr <> "") {
		cleanStartDatesplit = split(startDateStr, " ");
		cleanStartDate = cleanStartDatesplit[0];
		startDate = strtojavadate(cleanStartDate, "MM-dd-yyyy");
		// Record active if startDate <= currentDate (comparedates <= 0)
		if (comparedates(startDate, currentDate) > 0) {
			isActive = false;
		}
	}
	if (isActive AND endDateStr <> "") {
		cleanEndDatesplit = split(endDateStr, " ");
		cleanEndDate = cleanEndDatesplit[0];
		endDate = strtojavadate(cleanEndDate, "MM-dd-yyyy");
		// Record active if currentDate <= endDate (comparedates <= 0)
		if (comparedates(currentDate, endDate) > 0) {
			isActive = false;
		}
	}
	if (isActive) {
		edp = get(eachRow, "EDPCode");
		priceListStr = get(eachRow, "CashPrice");
		sMAStr = get(eachRow, "SMA");
		priceListPrice = 0.0;
		if (isnumber(priceListStr)) {
			put(cashpricedict, edp, (priceListStr));
		}
		sMA = 0.0;
		if (isnumber(sMAStr)) {
			put(SMAdict, edp, (sMAStr));
		}
	}
}
//print priceUpliftArr ;
defaultCategory = "ACCESSORY.MFP";
upliftRecordsJsonArray = jsonarray();
upliftRecordSet = recordset();
//Query RUS Uplift Details data table to grab the required values  customerSegment
upliftRecordSet = bmql("select SegmentLevel,ProductCategory4,PsMinGp,ProductFloor,SgaSegment,HwTargetPrice,MarketPlace,FyStartCustomerType,FyStartProductionZba,CustomerSegment,ProductCategory4,ActiveStartDate,ActiveEndDate,AccountCoverage from RAC_UPLIFT where (CustomerSegment = $customerSegment AND ProductCategory4 IN $priceUpliftArr) OR (CustomerSegment = $customerSegment AND ProductCategory4 = $defaultCategory) OR (CustomerSegment = 'DEFAULT' AND ProductCategory4 = 'DEFAULT')");
//print upliftRecordSet ;
//Populate upliftRecordsJsonArray with the required data
for eachRecord in upliftRecordSet {

	//Check for Active and ZBA flags as per existing logic
	//Check Active Start and End dates
	activeStartDateInNumber = 0;
	activeStartDateInStr = "";
	startDateStr = get(eachRecord, "ActiveStartDate");
	endDateStr = get(eachRecord, "ActiveEndDate");
	isActive = true;
	if (startDateStr <> "") {
		cleanStartDatesplit = split(startDateStr, " ");
		cleanStartDate = cleanStartDatesplit[0];
		activeStartDateInStr = replace(cleanStartDate, "/", "-");
		startDate = strtojavadate(activeStartDateInStr, "MM-dd-yyyy");
		// Record active if startDate <= currentDate (comparedates <= 0)
		if (comparedates(startDate, currentDate) > 0) {
			isActive = false;
		}
	}
	if (isActive AND endDateStr <> "") {
		cleanEndDatesplit = split(endDateStr, " ");
		cleanEndDate = cleanEndDatesplit[0];
		activeEndDateInStr = replace(cleanEndDate, "/", "-");
		endDate = strtojavadate(activeEndDateInStr, "MM-dd-yyyy");
		// Record active if currentDate <= endDate (comparedates <= 0)
		if (comparedates(currentDate, endDate) > 0) {
			isActive = false;
		}
	}
	if (isActive) {
		//print "activeRecord";
		CustomerSegment = get(eachRecord, "CustomerSegment");
		ProductCategory4 = get(eachRecord, "ProductCategory4");
		SegmentLevel = get(eachRecord, "SegmentLevel");
		PsMinGp = get(eachRecord, "PsMinGp");
		ProductFloor = get(eachRecord, "ProductFloor");
		SgaSegment = get(eachRecord, "SgaSegment");
		HwTargetPrice = get(eachRecord, "HwTargetPrice");
		MarketPlace = get(eachRecord, "MarketPlace");
		fyCustomerStartTypeStr = get(eachRecord, "FyStartCustomerType");
		fyCustomerStartTypeZBAStr = get(eachRecord, "FyStartProductionZba");

		if (fyCustomerStartTypeStr == "" OR isnull(fyCustomerStartTypeStr)) {
			fyCustomerStartTypeStr = "N";
		}
		if (fyCustomerStartTypeZBAStr == "" OR isnull(fyCustomerStartTypeZBAStr)) {
			fyCustomerStartTypeZBAStr = "N";
		}
		zbaflag = false;
		if (fyCustomerStartTypeStr == fyCustomerStartType AND fyCustomerStartTypeZBAStr == fYStartProductionZBA) {
			zbaflag = true;
			put(upliftdict, CustomerSegment + "_" + ProductCategory4, ProductFloor + "%^&" + PsMinGp + "%^&" + HwTargetPrice + "%^&" + SgaSegment + "%^&" + SegmentLevel + "%^&" + fyCustomerStartTypeStr + "%^&" + fyCustomerStartTypeZBAStr + "%^&" + "true");
		} elif (CustomerSegment == "DEFAULT" AND ProductCategory4 == "DEFAULT") {
			put(upliftdict, CustomerSegment + "_" + ProductCategory4, ProductFloor + "%^&" + PsMinGp + "%^&" + HwTargetPrice + "%^&" + SgaSegment + "%^&" + SegmentLevel + "%^&" + fyCustomerStartTypeStr + "%^&" + fyCustomerStartTypeZBAStr + "%^&" + "false");
		}
	}
} /// print upliftdict ;
linesjson = json();
indexes = range(jsonarraysize(lines));
print "Calculate Pricing HW START:::" + getstrdate();
print "Suresh Debug  : 108 START    Pricing Portal log ";
//print lineDetailsJSON;
print "Suresh Debug  : 108 END start"; // acquisitionType_c

for index in indexes {

	line = jsonarrayget(lines, index, "json");
	partNumber = jsonget(line, "_partNumber", "string");
	ProductCategory = jsonget(line, "rCIPriceUpliftCategory_c", "string");
	//print "partnumber : " + partNumber;
	if (partNumber == "") {
		continue;
	}
	cashPrice = 0.00;
	if (containskey(cashpricedict, partNumber)) {
		cashPrice = atof(get(cashpricedict, partNumber));
	}
	sMA = 0.00;
	if (containskey(SMAdict, partNumber)) {
		sMA = atof(get(SMAdict, partNumber));
	}
	priceComponents = "";
	if (containskey(upliftdict, CustomerSegment + "_" + ProductCategory)) {
		priceComponents = get(upliftdict, CustomerSegment + "_" + ProductCategory);
	} elif (containskey(upliftdict, CustomerSegment + "_" + defaultCategory)) {
		priceComponents = get(upliftdict, CustomerSegment + "_" + defaultCategory);
	} elif (containskey(upliftdict, "DEFAULT_DEFAULT")) {
		priceComponents = get(upliftdict, "DEFAULT_DEFAULT");
	}
	priceComponentsArr = split(priceComponents, "%^&");
	//ProductFloor + %^&" + PsMinGp + "%^&" + HwTargetPrice + "%^&" + SgaSegment + "%^&" + SegmentLevel + "%^&" + fyCustomerStartTypeStr + "%^&" + fyCustomerStartTypeZBAStr + "%^&" + "false");
	minGPPercentage = 0.00;
	productFloorval = 0.00;
	hardwareTargetPrice = 0.00;
	if (sizeofarray(priceComponentsArr) > 4) {
		productFloorval = atof(priceComponentsArr[0]);
		minGPPercentage = atof(priceComponentsArr[1]);
		hardwareTargetPrice = atof(priceComponentsArr[2]);
		// sgaSegment = priceComponentsArr[3];
		// segmentLevel = priceComponentsArr[4];
		// fyCustomerStartTypeStr = priceComponentsArr[5];
		// fyCustomerStartTypeZBAStr = priceComponentsArr[6];
		// zbaflag = priceComponentsArr[7];
	}
	defaultListPrice = jsonget(line, "defaultListPrice_c", "float", 0.0); //jsonget(line,"partListPrice_c","float",0.0);//jsonget(line,"defaultListPrice_c","float",0.0);
	price_quantity = jsonget(line, "priceQuantity_c", "integer", 1);

	//defaultListPrice = price_list_price_each;
	unitSRP = defaultListPrice;
	unitStandardCost = 0.0;
	initialSalesCost = 0.0;
	finalSalesCost = 0.0;
	contractedPrice = 0.0;
	stretchPriceUplift = 0.0;
	stretchPrice = 0.0;
	roundStretchPrice = 0.0;

	unitSellingPrice = 0.0;
	codePresent = true;
	vendorQuoteNumber_VLIG = "";
	businessLine_c = "TRADITIONAL";
	discounttype_l = "";
	discountAmountt_l = 0.0;
	vendorCost_c = 0.0;
	part_custom_field27 = "";
	modelNameForPart = "";
                //print minGPPercentage ;
                print sMA ;
	unitStandardCost = unitSRP * (1 - minGPPercentage);
	initialSalesCost = (unitStandardCost - sMA) * (1 + productFloorval);
	if (cashPrice > 0.0) {		
      //  print initialSalesCost;
		initialSalesCost = initialSalesCost + (cashPrice * (rebatePercentage / 100));
		//print initialSalesCost;
	} elif (codePresent AND cashPrice == 0.0) {
		initialSalesCost = 0.0;
	} else {
		initialSalesCost = initialSalesCost + (initialSalesCost * (rebatePercentage / 100));
	}

	finalSalesCost = 0.0;
	if (unitSRP <> 0.0 AND initialSalesCost <> 0.0) {
		salesCostArray = float[] {
			unitSRP,
			initialSalesCost
		};
		finalSalesCost = min(salesCostArray);
	} elif (unitSRP == 0.0 AND initialSalesCost <> 0.0) {
		finalSalesCost = initialSalesCost;
	} elif (unitSRP <> 0.0 AND initialSalesCost == 0.0 AND NOT codePresent) {
		finalSalesCost = unitSRP;
	}
	if ((businessLine_c == "ITS" AND modelNameForPart == "Equipment") OR (businessLine_c == "ITS" AND part_custom_field27 == "VP")) {
		contractedPrice = unitSRP;
	} else {
		contractedPrice = finalSalesCost * (1 + hardwareTargetPrice);
		if (contractedPrice > unitSRP) {
			contractedPrice = unitSRP;
		}
	}
	if (codePresent) {
		contractedPrice = cashPrice;
		unitSellingPrice = contractedPrice;
	}
	if (businessLine_c == "PS" OR businessLine_c == "TRADITIONAL" OR businessLine_c == "ITS") {
		if (vendorQuoteNumber_VLIG <> "" AND businessLine_c <> "ITS") {
			contractedPrice = unitSRP;
		} elif (unitSRP <> 0.0 AND contractedPrice <> 0.0 AND contractedPrice > unitSRP) {
			contractedPriceArray = float[] {
				unitSRP,
				contractedPrice
			};
			contractedPrice = min(contractedPriceArray);
		} elif (unitSRP <> 0.0 AND contractedPrice == 0.0 AND NOT codePresent) {
			contractedPrice = unitSRP;
		}
		unitSellingPrice = contractedPrice;
	}
	discounttype = discounttype_l;
	discountValueLine = discountAmountt_l;
	discountAmt = 0.0;

	if (discounttype == "" OR discounttype == "Stretch") {
		unitSellingPrice = contractedPrice;
	} elif (discounttype == "Override") {
		discountAmt = discountValueLine;
		unitSellingPrice = discountValueLine;
	} elif (discounttype == "Amount") {
		discountAmt = discountValueLine;
		unitSellingPrice = contractedPrice - discountValueLine;
	} elif (discounttype == "Percent") {
		discountAmt = ((discountValueLine / 100) * contractedPrice);
		unitSellingPrice = contractedPrice - ((discountValueLine / 100) * contractedPrice);
	}


	if (vendorQuoteNumber_VLIG <> "" AND (vendorCost_c == 0.0 OR vendorCost_c == 0.01)) {
		unitStandardCost = vendorCost_c;
	}

	unitNetPrice = unitSellingPrice;
	extNetSellprice = unitNetPrice * price_quantity;
	//print partNumber;
	// print UnitSRP;
	jsonput(line, "unitSRPO_l_c", round(unitSRP, 2));
	jsonput(line, "unitCostOutput_c", round(unitStandardCost, 2));
	jsonput(line, "unitSalesCostOutPut_c", round(finalSalesCost, 2));
	jsonput(line, "contractedUnitPriceOutput_c", round(contractedPrice, 2));
	jsonput(line, "contractPriceOutput_c", round(contractedPrice, 2));
	jsonput(line, "targetPriceOutPut_c", round(hardwareTargetPrice, 2));
	jsonput(line, "unitNetPriceOutPut_c", round(unitNetPrice, 2));
	jsonput(line, "extNetPriceOutPut_c", round(extNetSellprice, 2));
        jsonput(line, "unitSellingPrice_Ouput_c", round(unitSellingPrice, 2));

}
print "Calculate Pricing HW END:::" + getstrdate();
print " suresh debbigging END ";

print "pricingDocument pricingDocument*****";
print "Suresh108: Beforeformulas start";


print lineDetailsJSON;


logtime("t_pricing_perf TOTAL   Before Formulas new pricing Suresh using Realtime datatables", getcurrenttimeinmillis() - t_pricing_perf);
print " incremental priing exxecution logs";
print(getcurrenttimeinmillis() - t_pricing_perf) * 100000;
print "t_pricing_perf TOTAL   Before Formulas new pricing Suresh using Realtime datatables";
return lineDetailsJSON;
