                jsonput(relatedRuleJSON, "targetItem", targetItem);
                jsonput(relatedRuleJSON, "sourceSelected", sourceItemSelected);
                jsonput(relatedRuleJSON, "targetSelected", targetItemSelected);
                jsonput(relatedRuleJSON, "sourceSelectedInUI", sourceItemSelected);
                jsonput(relatedRuleJSON, "targetSelectedInUI", targetItemSelected);
