                }
                }*/
                ItemObjArr = jsonpathgetmultiple(masterStringJSON, itemPath);
                if (jsonarraysize(ItemObjArr) == 1 and jsonpathcheck(masterStringJSON, itemPath)) { //link the rule and UI item
                    ItemObj = jsonarrayget(ItemObjArr, 0, "json");
                    attributeName = jsonget(ItemObj, "attributeName", "string"); //IM430F-RF Rule id 5 not triggred as arrayset is not found
                    arraySet = jsonget(ItemObj, "arraysetName", "string", attributeName);
                    stepName = jsonget(ItemObj, "displayStepName", "string");
                    sourceIndex = jsonget(ItemObj, "index", "string");
                    sourcePartDescription = jsonget(ItemObj, "partDescription", "string", "");
                    jsonput(condObj, "sourceIndex", sourceIndex);
                    jsonput(condObj, "sourceAttribute", arraySet);
                    jsonput(condObj, "sourceStepName", stepName);
                    jsonput(condObj, "sourcePartDescription", sourcePartDescription);

                    if (arraySet <> "") { //added as part of qty changes		

                        quantity = jsonpathgetsingle(userSelectionsJSON, "$.attributeAndValues[?(@.arraySet == '" + arraySet + "' && @.item == '" + sourceItem + "')].quantity", "integer", 1);
                        jsonput(condObj, "quantity", quantity);
                    }

