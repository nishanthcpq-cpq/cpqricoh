            //path = "$..relatedRules[?((@.ruleId != '"+ruleID+"' "+filterCond+") && ("+join(queryItemCond," || ")+"))]";
            path = "$..relatedRules[?((@.ruleId != '" + ruleID + "' " + filterCond + ") && (" + join(queryItemCond, " || ") + ") && @.Visited == false)]"; //Defect#46 added Visited condition to improve the performance issue. RSL7604C 111 >> 123 >> 1 repeated mutliple times though it was visited already. 
