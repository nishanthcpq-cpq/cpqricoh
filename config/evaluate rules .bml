            //if(sourceArraysetFound and NOT targetArraysetFound){//link the rule and UI item
            //AND find(actionCondition,".")==-1
            if (NOT targetArraysetFound AND find(actionCondition, ".") == -1) { //link the rule and UI item//IM430F-RF Rule id 5 not triggred as index is not found
                itemPath = "$..[?(@.partNumber == '" + targetItem + "')]";
