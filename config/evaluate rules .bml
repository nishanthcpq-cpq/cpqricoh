                if (condStr == "") {
                    condStr = actCondition;
                    if (endswith(trim(actCondition), "OPTION CLASS")) {
                        condStr2 = trim(replace(actCondition, "OPTION CLASS", ""));
                    } else {
                        condStr2 = actCondition;
                    }
                } else {
                    condStr = condStr + "." + actCondition;
                    if (endswith(trim(actCondition), "OPTION CLASS")) {
                        condStr2 = condStr2 + "." + trim(replace(actCondition, "OPTION CLASS", ""));
                    } else {
                        condStr2 = condStr + "." + actCondition;
                    }
                }
                //AnyTrue (IMC3510SD-C.OC-IMC3510SD-CON.419419)Excludes AnyTrue (IMC3510SD-RIC.IMC3510SD-C.OC-IMC3510SD-PCO.413009)//rule 52
                if (startswith(actionCondition, baseModel) and findinarray(rulePathsArr, condStr) == -1 and sizeofarray(actionConditionsArr) > 3) { //genarally we will have 3levels in the condition but here we have 4. So to make it work, removed base model from condition checking.//defect 34047
                    condStr = replace(condStr, baseModel + ".", "");
                    condStr2 = replace(condStr, baseModel + ".", "");
                }
                if (findinarray(stepNamesArr, actCondition) <> -1 OR
                    findinarray(rulePathsArr, condStr) <> -1 OR findinarray(rulePathsArr, condStr2) <> -1) { //link the rule and UI item //defect 34047 added condStr2

                    pos = findinarray(stepNamesArr, actCondition);
                    arraySet = "";
                    stepName = "";
