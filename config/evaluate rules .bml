                            /*elif(functionName == "ANYTRUE" and sourceConditionMet and actionFunction == "ANYTRUE"  and  noOfTargetItems > 1 and (noOfTargetItems-1) == noOfExcludedItems and NOT isTargetExluded and NOT targetSelectedNested)
                            {//SG 06-01-2026
