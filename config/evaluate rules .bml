                if (startswith(conditions, baseModel) and findinarray(rulePathsArr, condStr) == -1 and sizeofarray(sourceConditionsArr) > 3) { //genarally we will have 3levels in the condition but here we have 4. So to make it work, removed base model from condition checking.
                    condStr = replace(condStr, baseModel + ".", "");
