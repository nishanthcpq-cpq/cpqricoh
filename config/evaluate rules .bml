                //itemPath = "$..[?((@.partNumber == '"+sourceItem+"') && ( @.stepName  =~ /.*"+conditions+".*/ ) )]";
                /*ItemObjArr = jsonpathgetmultiple(masterStringJSON,itemPath );
                ItemObjArrRange = range(jsonarraysize(ItemObjArr));
