                    found = true;
                    //sourceArrayset = arraysets[itemPos];
                }
                if (findinarray(itemsPathsArr, sourceCondition) <> -1) {
                    found = true;
                }
                append(conditionMet, found);

            }
            ////print conditionMet;
            actionConditionsArr = split(actionCondition, ".");
            actionConditionMet = boolean[];
            condStr = "";

            for actCondition in actionConditionsArr { //eval the action condition

                found = false;
                /*if(condStr == ""){
                	condStr = actCondition;
