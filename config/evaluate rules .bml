                        */
                        if (applySourceExclusion) {
                            jsonput(recommendation, "operator", "EXCLUDES");
                            jsonput(recommendation, "sourceIndex", targetIndex); //target becomes source for exlusion
                            jsonput(recommendation, "targetIndex", sourceIndex); //source becomes target for exlusion			
                            jsonput(recommendation, "sourceAttribute", targetAttribute);
                            jsonput(recommendation, "targetAttribute", sourceAttribute);
                            jsonput(recommendation, "sourceConditions", targetItemNested);
                            jsonput(recommendation, "actionConditions", sourceItemNested);

