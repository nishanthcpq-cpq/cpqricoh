            if (upper(functionName) == "CONTRIBUTE" and (sourceItem == targetItem)) {
                contributeRule = json();
                jsonput(contributeRule, "ruleId", ruleId);
                jsonput(contributeRule, "sourceConditions", conditions);
                jsonput(contributeRule, "actionConditions", actionCondition);
