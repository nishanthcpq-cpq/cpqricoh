                            elif (functionName == "ANYTRUE" and atleastOneTargetItemSelected and targetSelectedNested and actionFunction == "ANYTRUE" and operatorNested <> "DEFAULTS") { //Defect #28567 - added DEFAULTS cond. self constraint issue on 3rd additional unit selction and update. Rule 36 shouldn't be triggered
                                applySourceExclusion = true;
