                            //update the references
                            jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + targetItemNested + "')].sourceConditionMet", true);
                            jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + targetItemNested + "')].targetConditionMet", true);

                            jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + targetItemNested + "')].sourceSelected", true);
                            jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + targetItemNested + "')].targetSelected", true);

                            if (targetItemNested <> "" and find(targetItemNested, ".") <> -1) { //Defect #28812 issue5, rule#275 CONFIGURE EQUIPMENT.ADDITIONAL UNIT FOR 7605.S 5DR SATELLITE LOCKER (LARGE LOCKERS).9P39750 [1ST ADDITIONAL UNIT] . some rules(123) has target 9P39750 [1ST ADDITIONAL UNIT] without path
                                actionConditionArr = split(targetItemNested, ".");
                                selectedItem = actionConditionArr[sizeofarray(actionConditionArr) - 1];
                                jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + selectedItem + "')].sourceConditionMet", true);
                                jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + selectedItem + "')].targetConditionMet", true);

                                jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + selectedItem + "')].sourceSelected", true);
                                jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + selectedItem + "')].targetSelected", true);
                            }

                        } elif (applyTargetExclusion) {
                            jsonput(recommendation, "operator", "EXCLUDES");
                            jsonput(recommendation, "setType", "forceSet");
                            jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + targetItemNested + "')].isSourceExluded", true);
                            jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + targetItemNested + "')].isTargetExluded", true);

                            jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + targetItemNested + "')].isSourceExluded", true);
                            jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + targetItemNested + "')].isTargetExluded", true);

                        }

                        //Added for warning messages for override --Start
                        tempsourceConditions = jsonget(recommendation, "sourceConditions", "string", "");
                        if (tempsourceConditions <> "") {
                            sarr = split(tempsourceConditions, ".");
                            sarr = reverse(sarr);
                            hovermessage = "Selecting this item will automatically restrict the availability of item " + sarr[0] + " and any other dependent items.";
                            //hovermessage=ErrorMessage;
                            jsonput(recommendation, "Message", hovermessage);
                        }
                        //17/02/2025  added for C014
                        if (defaultRuleNested == "Y") {
                            defaultMsg = "";
                            if (operatorNested == "EXCLUDES") {
                                defaultMsg = "This item cannot be added to this Model if you need this accessory select a different Model";
                            } else {
                                defaultMsg = "This item is required to be added to this Model";
                            }
                            jsonput(recommendation, "Message", defaultMsg);
                        }
                        //------------------Building messages for Warning message--Start
                        //28950
                        targetIndexMsg = jsonget(recommendation, "targetIndex", "string", "");
                        sourceIndexMsg = jsonget(recommendation, "sourceIndex", "string", "");
                        if (targetIndexMsg <> "" AND sourceIndexMsg <> "") {
                            targetAttributeMsg = jsonget(recommendation, "targetAttribute");
                            sourceAttributeMsg = jsonget(recommendation, "sourceAttribute");
                            sourceConditionMsg = jsonget(recommendation, "sourceConditions");
                            actionConditionMsg = jsonget(recommendation, "actionConditions");
                            targetPath = targetAttributeMsg + "_" + targetIndexMsg;
                            sourcePath = sourceAttributeMsg + "_" + sourceIndexMsg;
                            targetKey = actionConditionMsg;
                            sourceKey = sourceConditionMsg;
                            unSelOverrideMsg = json();
                            jsonput(unSelOverrideMsg, "ruleId", ruleIdNested);

                            jsonput(unSelOverrideMsg, "chainRule", ruleID);
                            jsonput(unSelOverrideMsgs, targetKey + "#" + sourceKey, unSelOverrideMsg);
                            jsonput(unSelOverrideMsgs, sourceKey + "path", sourcePath);
                            jsonput(unSelOverrideMsgs, targetKey + "path", targetPath);

                            jsonput(unSelOverrideMsgs, sourceKey + "#" + targetKey, unSelOverrideMsg);
                            description = "";
                            actionDesc = "";
                            actionPartNumber = "";
                            partNumber = "";
                            actionDescPath = "$." + targetAttributeMsg + "[?(@.index =='" + targetIndexMsg + "')].partDescription";
                            descriptionPath = "$." + sourceAttributeMsg + "[?(@.index =='" + sourceIndexMsg + "')].partDescription";
                            if (jsonpathcheck(masterStringJSON, descriptionPath)) {
                                partNumber = jsonpathgetsingle(masterStringJSON, "$." + sourceAttributeMsg + "[?(@.index == '" + sourceIndexMsg + "')].partNumber");
                                des = jsonpathgetsingle(masterStringJSON, descriptionPath);
                                des_arr = split(des, "\n");
                                description = partNumber + " " + des_arr[0];
                            }
                            if (jsonpathcheck(masterStringJSON, actionDescPath)) {
                                actionPartNumber = jsonpathgetsingle(masterStringJSON, "$." + targetAttributeMsg + "[?(@.index =='" + targetIndexMsg + "')].partNumber");
                                des = jsonpathgetsingle(masterStringJSON, actionDescPath);
                                des_arr = split(des, "\n");
                                actionDesc = actionPartNumber + " " + des_arr[0];
                            }
                            jsonput(unSelOverrideMsgs, sourceKey, description);
                            jsonput(unSelOverrideMsgs, targetKey, actionDesc);


                        }
                        //------------------Building messages for Warning message--END			
                        //------end
                        jsonarrayappend(recommendations, recommendation);
                        jsonput(defaultsAndMessages, "recommendations", recommendations);
                        if (find(sourceItemNested, "'") == -1 and find(targetItemNested, "'") == -1 and find(sourceItemNested, "\"") == -1 and find(targetItemNested, "\"") == -1) {
                            if (findinarray(visitedItems, sourceItemNested) <> -1) { //28812 - double update issue - the item was marked as visited, but now selected through chaining so it must be revisited
                                vItemPos = findinarray(visitedItems, sourceItemNested);
                                remove(visitedItems, vItemPos);
                                //if(endswith(sourceItemNested,"9P39750 [1ST ADDITIONAL UNIT]")){
                                //print "this rule==="+ruleIdNested ;
                                //}
                            }
                            if (findinarray(visitedItems, targetItemNested) <> -1) { //28812 - double update issue - the item was marked as visited, but now selected through chaining so it must be revisited
                                vItemPos = findinarray(visitedItems, targetItemNested);
                                remove(visitedItems, vItemPos);
                                //if(endswith(sourceItemNested,"9P39750 [1ST ADDITIONAL UNIT]")){
                                //print "this rulevv==="+ruleIdNested ;
                                //}
                            }
                            if (findinarray(queryItems, sourceItemNested) == -1) { //Defect#46 added condition to resolve performance issue 
                                append(queryItems, sourceItemNested);
                            }
                            if (findinarray(queryItems, targetItemNested) == -1) { //Defect#46 added condition to resolve performance issue 
                                append(queryItems, targetItemNested);
                            }
                            //append(queryItems,sourceItemNested);
                            //append(queryItems,targetItemNested);
                        } else {
                            print "Problematic------";
                            //print sourceItemNested;
                            //print targetItemNested;
                        }
                        append(checkDuplicates, duplicate); //28812 - double update issue #issue 5
                    } elif (showMessage) {
                        if (findinarray(messageRuleIDs, ruleIdNested) == -1) {
                            append(messageRuleIDs, ruleIdNested);
                            //print "messageRuleIDs-->"+ruleIdNested;
                        }

                    }
                    //append(checkDuplicates,duplicate);//28812 - double update issue #issue 5	
                }
                ////print "Reached Here---->";
                //relatedItemJSON = jsonpathgetsingle(relationshipJSON,);
            }

        }

    }
    //28950
    Final_warning_messages_json = util.getImpactedEDPCodesList(jsontostr(unSelOverrideMsgs), masterString, jsontostr(defaultsAndMessages));

    print "UnSelOverrideMsgs:::";
    print Final_warning_messages_json;
    endTime = getcurrenttimeinmillis();
    ////print "Reached Here1---->";
    /*end of Chaining rules */
    logTime(modelName + logComments + "Chaining Rules Evaleuation", endTime - startTime);
    endTime = getcurrenttimeinmillis();
    logTime(modelName + logComments + "Chaining Rule Unselect", endTime - startTime);
    logTime("Chaining Rule Unselect***", endTime - startTime);
    //==========================Autounselect chaining Items END

    /*ST/SG defect 28950*/ //added to deselect dependent rules when override is happen
    pathcheck_un = jsonpathcheck(userSelectionsJSON, "$.unselectedvalues..arraySet");
    overrideitemspath = jsonpathcheck(userSelectionsJSON, "$..attributeAndValues[?(@.Override == 'true')]"); //Defect #29082 -  PROC5410S - rule 17 - double update issue on override of E28B-MEM32GB
    jsonput(defaultsAndMessages, "AutoUnSelect", autodeselectjsarray); //Defect #29082 -  PROC5410S - rule 17 - double update issue on override of E28B-MEM32GB
    if ((override_flag OR pathcheck_un or overrideitemspath) AND jsonpathcheck(constraintAndRecStringJson, "$.defaultsAndMessages.recommendations")) {
        previousRecemmendations = jsonpathgetsingle(constraintAndRecStringJson, "$.defaultsAndMessages.recommendations", "jsonarray", jsonarray());
        indexes = range(jsonarraysize(previousRecemmendations));
        recommendations = jsonget(defaultsAndMessages, "recommendations", "jsonarray", jsonarray());
        for i in indexes {
            recommendation = jsonarrayget(previousRecemmendations, i, "json");
            ruleId = jsonget(recommendation, "appliedRuleId", "string");
            operator = jsonget(recommendation, "operator", "string");
            actionConditions = jsonget(recommendation, "actionConditions", "string");
            sourceConditions = jsonget(recommendation, "sourceConditions", "string");
            pathCheck = jsonpathcheck(defaultsAndMessages, "$..recommendations[?(@.appliedRuleId =='" + ruleId + "' && (@.operator == 'IMPLIES' || @.operator == 'DEFAULTS'))]");
            foundActiveRule = jsonpathcheck(defaultsAndMessages, "$..recommendations[?(@.actionConditions =='" + actionConditions + "')]"); //Defect #28567 P800 - issue#3 double update issue on override
            if (not pathCheck and operator <> "EXCLUDES" and Not foundActiveRule) {
                jsonput(recommendation, "value", false);
                jsonput(recommendation, "appliedFrom", "Unset"); //
                //jsonput(recommendation,"chainRule","-1");//unset chain rule id
                jsonarrayappend(autodeselectjsarray, recommendation);
            }
            checkPath = "$..recommendations[?(@.appliedRuleId =='" + ruleId + "' && @.sourceConditions == '" + sourceConditions + "' && @.actionConditions =='" + actionConditions + "')]";
            foundActiveRule = jsonpathcheck(defaultsAndMessages, checkPath); //Defect #28567 P800 - issue#3 double update issue on override
            //if active rule is there and override is trying to exclude the item
            if (foundActiveRule) { //Defect #29082 -  PROC5410S - rule 17 - double update issue on override of E28B-MEM32GB
                removePath = "$..AutoUnSelect[?(@.appliedRuleId == '" + ruleId + "' && @.sourceConditions == '" + sourceConditions + "' && @.actionConditions == '" + actionConditions + "')]";
                removePathCheck = jsonpathcheck(defaultsAndMessages, removePath);
                if (removePathCheck) {
                    jsonpathremove(defaultsAndMessages, removePath);
                }

            }
            checkPath = "$..recommendations[?(@.appliedRuleId =='" + ruleId + "' && @.sourceConditions == '" + actionConditions + "' && @.actionConditions =='" + sourceConditions + "')]";
            foundActiveRule = jsonpathcheck(defaultsAndMessages, checkPath); //Defect #28567 P800 - issue#3 double update issue on override
            if (foundActiveRule) { //Defect #29082 -  PROC5410S - rule 17 - double update issue on override of E28B-MEM32GB
                removePath = "$..AutoUnSelect[?(@.appliedRuleId == '" + ruleId + "' && @.sourceConditions == '" + actionConditions + "' && @.actionConditions == '" + sourceConditions + "')]";
                removePathCheck = jsonpathcheck(defaultsAndMessages, removePath);
                if (removePathCheck) {
                    jsonpathremove(defaultsAndMessages, removePath);
                }


            }

        }
    }

    //end of defect 28950*/
    /*comination rules Defect #28743,28567 28546*/
    recommendations = jsonget(defaultsAndMessages, "recommendations", "jsonarray", jsonarray());
    recommendationsFinal = jsonarray();
    indexes = range(jsonarraysize(recommendations));
    dontApply = string[];
    for i in indexes {
        recommendation = jsonarrayget(recommendations, i, "json");
        ruleId = jsonget(recommendation, "appliedRuleId", "string");
        functionName = jsonget(recommendation, "functionName", "string");
        actionFunctionName = jsonget(recommendation, "actionFunctionName", "string");
        operator = jsonget(recommendation, "operator", "string");
        sourceConditions = jsonget(recommendation, "sourceConditions", "string");
        actionConditions = jsonget(recommendation, "actionConditions", "string");

        if (functionName == "ALLTRUE" and actionFunctionName == "ANYTRUE" and operator == "EXCLUDES") {
            //print "conflict>>>>"+ruleId;
            sourceItem = jsonpathgetsingle(relationshipJSON, "$..relatedRules[?(@.ruleId == '" + ruleId + "' && ((@.sourceConditions == '" + sourceConditions + "' && @.actionConditions == '" + actionConditions + "') || (@.sourceConditions == '" + actionConditions + "' && @.actionConditions == '" + sourceConditions + "') ))].sourceItem", "string", "");
            targetItem = jsonpathgetsingle(relationshipJSON, "$..relatedRules[?(@.ruleId == '" + ruleId + "' && ((@.sourceConditions == '" + sourceConditions + "' && @.actionConditions == '" + actionConditions + "') || (@.sourceConditions == '" + actionConditions + "' && @.actionConditions == '" + sourceConditions + "') ))].targetItem", "string", "");

            //print sourceItem;
            //print targetItem;
            selectedAt = jsonpathgetsingle(userSelectionsJSON, "$.attributeAndValues[?(@.item == '" + sourceItem + "' && @.selectionSource == 'USER')].selectedAt", "integer", 0);
            selectedAt1 = jsonpathgetsingle(userSelectionsJSON, "$.attributeAndValues[?(@.item == '" + targetItem + "' && @.selectionSource == 'USER')].selectedAt", "integer", 0);
            pathCheck = jsonpathcheck(defaultsAndMessages, "$..recommendations[?(@.appliedRuleId !='" + ruleId + "' && @.operator == 'EXCLUDES' && @.functionName == 'ALLTRUE' && @.actionFunctionName == 'ANYTRUE' && @.sourceConditions == '" + actionConditions + "' && @.actionConditions == '" + sourceConditions + "')]");
            //print selectedAt;
            //print selectedAt1;
            //print pathCheck;
            ////Defect 29912 - override issue added selectedAt1 <> 0, selectedAt <> 0
            if ((pathCheck and selectedAt1 > selectedAt and selectedAt1 <> 0 and selectedAt <> 0) or findinarray(dontApply, ruleId) <> -1) { //latest user selection is priority
                append(dontApply, ruleId);
                continue;
            }
        }
        if (findinarray(messageRuleIDs, ruleId) <> -1) { // Defect#30152 PROC9500P-RIC when 409254 is selected The warning message that device requires is still showing as unsatisfied even though 409250 is now selected.
            foundActiveRule = jsonpathcheck(defaultsAndMessages, "$..recommendations[?(@.actionConditions =='" + actionConditions + "' && @.operator == 'IMPLIES')]");
            if (foundActiveRule) {
                rulePos = findinarray(messageRuleIDs, ruleId);
                remove(messageRuleIDs, rulePos);
            }
        }
        jsonarrayappend(recommendationsFinal, recommendation);
    }
    /* end of combination rules*/
    recommendations = recommendationsFinal;
    /*ST Defect 28400 - sort the exclusions first*/
    jsoncrit = jsonarray();
    crit1 = json("{\"field\":\"setType\",\"order\":\"asc\"}"); //type default to string
    crit2 = json("{\"field\":\"value\",\"order\":\"desc\"}"); //type default to string//Defect 28743 - to resolve override and direct selection conflict. first select 1st AU, override 2nd AU , 1st AU should be selected again
    crit3 = json("{\"field\":\"actionConditions\",\"order\":\"asc\"}");
    jsonarrayappend(jsoncrit, crit1);
    jsonarrayappend(jsoncrit, crit2);
    jsonarrayappend(jsoncrit, crit3);
    recommendations = util.abo_jsonSort(recommendations, jsoncrit);
    //-----------------------------New Code for ERROR Messages Start
    constraintMessages = json();
    for mRuleId in messageRuleIDs {
        ruleDataObj = jsonget(rulesData, mRuleId, "json");
        operator = jsonget(ruleDataObj, "operator");
        msg = replace(jsonget(ruleDataObj, "ErrorMessage"), "IMPLIES", "REQUIRES");
        if (msg <> "" AND NOT isnull(msg)) {
            conditionsObj = jsonget(ruleDataObj, "conditions", "jsonarray");
            indexes = range(jsonarraysize(conditionsObj));
            foundActiveRule = false;
            // Defect#30152 PROC9500P-RIC when 409254 is selected The warning message that device requires is still showing as unsatisfied even though 409250 is now selected.
            for i in indexes {
                condObj = jsonarrayget(conditionsObj, i, "json");
                actionConditions = jsonget(condObj, "actionConditions", "string", "");
                //print mRuleId+">>>>>>>>>>>>>>>>>>>>>>>>>>"+actionConditions ;
                foundActiveRule = jsonpathcheck(defaultsAndMessages, "$..recommendations[?(@.actionConditions =='" + actionConditions + "' && @.operator == 'IMPLIES')]");
                if (foundActiveRule) {
                    break;
                }
                //print foundActiveRule;

            }
            if (foundActiveRule) {
                continue;
            }
            for i in indexes {
                condObj = jsonarrayget(conditionsObj, i, "json");
                targetStepName = jsonget(condObj, "targetStepName", "string", "");
                isExluded = jsonget(condObj, "isExluded", "boolean", false);
                if (isExluded) {
                    continue;
                }
                constraintMessagesArr = jsonget(constraintMessages, targetStepName, "jsonarray", jsonarray());
                constraintMessage = json();
                jsonput(constraintMessage, "appliedRuleId", mRuleId);
                jsonput(constraintMessage, "operator", operator);
                jsonput(constraintMessage, "message", msg);
                jsonarrayappend(constraintMessagesArr, constraintMessage);
                jsonput(constraintMessages, targetStepName, constraintMessagesArr);
                break;
            }
        }

    }
    //jsonput(defaultsAndMessages,"AutoUnSelect",autodeselectjsarray);//Defect #29082 -double update issue - moved to line 2163
    jsonput(defaultsAndMessages, "WaningMessages", Final_warning_messages_json);
    jsonput(defaultsAndMessages, "recommendations", recommendations);
    /* end of Defect 28400 */
    logTime("Chaining Rule Unselect**11*", endTime - startTime);
    if (NOT suppressWarnings) { // condition added by SureshThota for SuppressWarning
        jsonput(defaultsAndMessages, "constraintMessages", constraintMessages);
    }
} else {
    // CHG0097681: preowned serialized unit - force these keys empty, matching the types
    // the normal path produces (recommendations & AutoUnSelect are jsonarray(); WaningMessages
    // [existing key name/typo, not "WarningMessages"] & constraintMessages are json()).
    // constraintMessages stays gated by suppressWarnings to match the normal path's behavior.
    rowCount = 0;
    jsonput(defaultsAndMessages, "recommendations", jsonarray());
    jsonput(defaultsAndMessages, "AutoUnSelect", jsonarray());
    jsonput(defaultsAndMessages, "WaningMessages", json());
    if (NOT suppressWarnings) {
        jsonput(defaultsAndMessages, "constraintMessages", json());
    }
}
jsonput(results, "defaultsAndMessages", defaultsAndMessages);
jsonput(results, "BOM", bomItemsArray);
jsonput(results, "orderType", orderType);
jsonput(results, "configureItem", configureItem);
jsonput(results, "mainUnitEDPCode", mainUnitEDPCode); //Defect #32913
jsonput(results, "Version", 2);
jsonput(results, "rowCount", rowCount);
jsonput(results, "OrgName", orgName);
jsonput(results, "otherParams", otherParamsJSON);

endTime = getcurrenttimeinmillis();
logTime("Chaining Rule Unselect**111*", endTime - startTime);
logTime("Rules New5 - Total", endTime - startTime1);
return results;