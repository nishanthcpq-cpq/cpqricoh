////print "here--->";
userSelectionsJSON = json(userSelections);
//-----------Checking Overriddenitems condtion SG ADDED ---> start
autodeselectjsarray = jsonarray();
unselectedrules = string[];
override_flag = false;
if (constraintAndRecString <> "") {
    overrideitemspath = jsonpathcheck(userSelectionsJSON, "$..attributeAndValues[?(@.Override == 'true')]");
    prevconstraint_arr = jsonarray();
    if (overrideitemspath) {
        overrideitems = jsonpathgetmultiple(userSelectionsJSON, "$..attributeAndValues[?(@.Override == 'true')]");
        indexes = range(jsonarraysize(overrideitems));
        override_flag = true;
        for i in indexes {
            overridejs = jsonarrayget(overrideitems, i, "json");
            item = jsonget(overridejs, "item");
            index = jsonget(overridejs, "index");
            optionFeature = jsonget(overridejs, "optionFeature");
            arraySet = jsonget(overridejs, "arraySet");
            //making Override item selected in UI
            //--------------------------------Start
            tempjs = json();
            jsonput(tempjs, "appliedRuleId", "");
            jsonput(tempjs, "operator", "IMPLIES");
            jsonput(tempjs, "setType", "set");
            jsonput(tempjs, "value", true);
            jsonput(tempjs, "targetIndex", index);
            jsonput(tempjs, "targetAttribute", arraySet);
            jsonput(tempjs, "selctionApplied", "Override"); // added to identify in Override in UI happened
            jsonarrayappend(autodeselectjsarray, tempjs);
            //---------------------------------END
            prevconstraint_path = "$.defaultsAndMessages.recommendations[?(@.operator == 'EXCLUDES' && @.targetIndex =='" + index + "' && @.targetAttribute == '" + arraySet + "')]";
            if (jsonpathcheck(constraintAndRecStringJson, prevconstraint_path)) {
                prevconstraint_arr = jsonpathgetmultiple(constraintAndRecStringJson, prevconstraint_path);
                index1 = range(jsonarraysize(prevconstraint_arr));
                for j in index1 {
                    prevconstraintjs = jsonarrayget(prevconstraint_arr, j, "json");
                    chainRule = jsonget(prevconstraintjs, "chainRule", "string", "");
                    ruleID = jsonget(prevconstraintjs, "appliedRuleId", "string"); //5
                    rule_ID = jsonget(prevconstraintjs, "appliedRuleId", "string"); //Defect #28567
                    sourceConditions = jsonget(prevconstraintjs, "sourceConditions", "string");
                    actionConditions = jsonget(prevconstraintjs, "actionConditions", "string");
                    sourceAttribute = jsonget(prevconstraintjs, "sourceAttribute", "string");
                    targetAttribute = jsonget(prevconstraintjs, "targetAttribute", "string");
                    sourceIndex = jsonget(prevconstraintjs, "sourceIndex", "string", "");
                    targetIndex = jsonget(prevconstraintjs, "targetIndex", "string", "");
                    functionName = jsonget(prevconstraintjs, "functionName", "string", "");
                    actionFunctionName = jsonget(prevconstraintjs, "actionFunctionName", "string", "");
                    combination_rule = jsonget(prevconstraintjs, "combination_rule", "boolean", false);
                    operator = jsonget(prevconstraintjs, "operator", "string", "");
                    if (combination_rule AND operator == "EXCLUDES" AND functionName == "ALLTRUE" AND actionFunctionName == "ANYTRUE") { //Defect 29912 - override issue
                        continue;
                    }
                    if (chainRule <> "" AND NOT isnull(chainRule)) {
                        chainRulepath = "$.defaultsAndMessages.recommendations[?(@.appliedRuleId =='" + chainRule + "' || @.appliedRuleId =='" + rule_ID + "')]"; //Defect #28567 added rule_ID  - P800#rule 5, 22633 should be excluded on override of 52642
                        if (jsonpathcheck(constraintAndRecStringJson, chainRulepath)) {
                            chainRulearray = jsonpathgetmultiple(constraintAndRecStringJson, chainRulepath);
                            index2 = range(jsonarraysize(chainRulearray));
                            for k in index2 {
                                chainrulejs = jsonarrayget(chainRulearray, k, "json");
                                ruleID = jsonget(chainrulejs, "appliedRuleId", "string");
                                sourceConditions = jsonget(chainrulejs, "sourceConditions", "string");
                                actionConditions = jsonget(chainrulejs, "actionConditions", "string");
                                sourceAttribute = jsonget(chainrulejs, "sourceAttribute", "string");
                                chainRuleOperator = jsonget(chainrulejs, "operator", "string", "");
                                targetAttribute = jsonget(chainrulejs, "targetAttribute", "string");
                                sourceIndex = jsonget(chainrulejs, "sourceIndex", "string", "");
                                targetIndex = jsonget(chainrulejs, "targetIndex", "string", "");

                                if (chainRuleOperator == "DEFAULTS") { //P800 , rule 5 override double update issue 
                                    jsonput(chainrulejs, "setType", "set");
                                    jsonput(chainrulejs, "value", false);
                                } else {
                                    jsonput(chainrulejs, "setType", "forceSet");
                                    jsonput(chainrulejs, "value", false);
                                }
                                jsonput(chainrulejs, "sourceIndex", targetIndex);
                                jsonput(chainrulejs, "targetIndex", sourceIndex);
                                jsonput(chainrulejs, "sourceAttribute", targetAttribute);
                                jsonput(chainrulejs, "targetAttribute", sourceAttribute);
                                jsonput(chainrulejs, "sourceConditions", actionConditions);
                                jsonput(chainrulejs, "actionConditions", sourceConditions);
                                jsonput(chainrulejs, "deselctionAppliedRule", rule_ID);
                                jsonput(chainrulejs, "deselctionApplied", "ChainingruleOverride");
                                userselectedpath = "$..attributeAndValues[?(@.arraySet == '" + sourceAttribute + "' && @.index =='" + sourceIndex + "')]";
                                if (jsonpathcheck(userSelectionsJSON, userselectedpath)) {
                                    remVal1 = jsonpathremove(userSelectionsJSON, userselectedpath);
                                }
                                if (chainRuleOperator == "IMPLIES" OR chainRuleOperator == "DEFAULTS") { //Defect#29082 - rule 31 when E48B-MEM32GB is overridden remove 409767 from user selections//P800 , rule 5 override double update issue 
                                    userselectedpath = "$..attributeAndValues[?(@.arraySet == '" + targetAttribute + "' && @.index =='" + targetIndex + "')]";
                                    if (jsonpathcheck(userSelectionsJSON, userselectedpath)) {
                                        remVal1 = jsonpathremove(userSelectionsJSON, userselectedpath);
                                    }
                                }
                                jsonarrayappend(autodeselectjsarray, chainrulejs);
                                append(unselectedrules, ruleID);
                            }
                        }
                    } else {
                        // making all targets available when Excludes alltrue scenario --------------Start added on 1-17-26
                        //A exlcudes alltrue B,C,D--> if user selects A,B than C will get excluded
                        //Expectation: When c is overridden A and B both will be available



                        setType = "forceSet";
                        //srini added " OR actionFunctionName == "ALLTRUE" on 09-15-2026 as part of incident 
                        if (chainRule == "" AND (functionName == "ALLTRUE" OR actionFunctionName == "ALLTRUE")) {
                            setType = "set";
                        }
                        //------------------------------------------------------------------END	
                        jsonput(prevconstraintjs, "setType", setType);
                        jsonput(prevconstraintjs, "value", false);
                        jsonput(prevconstraintjs, "sourceIndex", targetIndex);
                        jsonput(prevconstraintjs, "targetIndex", sourceIndex);
                        jsonput(prevconstraintjs, "sourceAttribute", targetAttribute);
                        jsonput(prevconstraintjs, "targetAttribute", sourceAttribute);
                        jsonput(prevconstraintjs, "sourceConditions", actionConditions);
                        jsonput(prevconstraintjs, "actionConditions", sourceConditions);
                        jsonput(prevconstraintjs, "deselctionApplied", "DirectRuleOverride");
                        userselectedpath = "$..attributeAndValues[?(@.arraySet == '" + sourceAttribute + "' && @.index =='" + sourceIndex + "')]";
                        if (jsonpathcheck(userSelectionsJSON, userselectedpath)) {
                            remVal1 = jsonpathremove(userSelectionsJSON, userselectedpath);
                        }
                        jsonarrayappend(autodeselectjsarray, prevconstraintjs);
                        append(unselectedrules, ruleID);
                    }
                    //making rule source was constined if unselected tardet was overridden 	
                }
            }

        }

    }
}

