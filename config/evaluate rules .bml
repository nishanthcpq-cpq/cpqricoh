                        arraySet = arraysetArr[pos];
                        stepName = displayStepNamesArr[pos];
                    }
                    pos = findinarray(rulePathsArr, condStr);
                    if (pos <> -1) {
                        arraySet = arraysetArr[pos];
                        stepName = displayStepNamesArr[pos];
                    }
                    pos = findinarray(rulePathsArr, condStr2); //defect 34047
                    if (pos <> -1) { //defect 34047
                        arraySet = arraysetArr[pos];
                        stepName = displayStepNamesArr[pos];
                    }
                    jsonput(condObj, "targetAttribute", arraySet);
                    jsonput(condObj, "targetStepName", stepName);
                    jsonput(condObj, "targetIndex", ""); //dummy		
                    jsonput(condObj, "targetPartDescription", stepName);
                    if (arraySet <> "") { //added as part of qty changes		

                        quantity = jsonpathgetsingle(userSelectionsJSON, "$.attributeAndValues[?(@.arraySet == '" + arraySet + "' && @.item == '" + targetItem + "')].quantity", "integer", 1);
                        jsonput(condObj, "quantity", quantity);
                    }
                    targetArraysetFound = true;
                    itemPath = "$.." + arraySet + "[?(@.partNumber == '" + targetItem + "')]";
                    ItemObjArr = jsonpathgetmultiple(masterStringJSON, itemPath);
