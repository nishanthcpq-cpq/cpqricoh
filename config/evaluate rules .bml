            if (jsonarraysize(selectedSourcePathArr) <> 0) {
                selectedSourceAttribute = jsonarrayget(selectedSourcePathArr, 0);
            }
            selectedTargetPathArr = jsonpathgetmultiple(userSelectionsJSON, "$.attributeAndValues[?( @.item == '" + targetItem + "' || (@.optionFeature == '" + actionCondition + "' && @.arraySet != '' ))].arraySet"); //07-20 defect #35731 in json filter added && @.arraySet != ''
            if (jsonarraysize(selectedTargetPathArr) <> 0) {
                selectedTargetAttribute = jsonarrayget(selectedTargetPathArr, 0);
            }
