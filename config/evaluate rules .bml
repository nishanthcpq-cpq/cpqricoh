                        jsonput(condObj, "targetPartDescription", targetPartDescription);
                        found = true;

                    }
                    if (NOT jsonpathcheck(masterStringJSON, itemPath) and arraySet <> "") { //check if atleast one is selected

                        if (jsonpathcheck(userSelectionsJSON, "$.attributeAndValues[?(@.arraySet == '" + arraySet + "')]")) {
                            found = true;

                        }

                    }
                }
                if (configType == actCondition OR findinarray(configTypeArr, actCondition) <> -1) { // Defect #26905
                    found = true;
                }
                if (baseModel == actCondition) {
                    found = true;
                }
                if (upper(operator) == "EXCLUDES" AND selectedAccount <> "" AND find(UPPER(actCondition), "CHOOSE ACCOUNT") <> -1) {
