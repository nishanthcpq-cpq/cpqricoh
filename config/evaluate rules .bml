            targetIndex = jsonget(condObj, "targetIndex", "string", "");
            isSourceStepLevel = jsonget(condObj, "sourceConditionLevel", "string", "") == "Y";
            isTargetStepLevel = jsonget(condObj, "sourceConditionLevel", "string", "") == "Y";
            if (upper(functionName) <> "CONTRIBUTE" and
                ((sourceIndex <> "" and targetIndex <> "") or
                    (sourceIndex == "" and isSourceStepLevel and targetIndex <> "") or
