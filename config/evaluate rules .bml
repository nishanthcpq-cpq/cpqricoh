                    append(queryItemCond, "(@.sourceConditions == '" + queryItem + "' && @.sourceSelected == true)");
                    append(queryItemCond, "(@.actionConditions == '" + queryItem + "' &&  (@.targetSelected == true || @.isTargetExluded == true))");
                    append(visitedItems, queryItem);
