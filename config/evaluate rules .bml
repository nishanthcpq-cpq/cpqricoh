            }
            //if(upper(functionName) == "CONTRIBUTE"  and findinarray(conditionMet,false) == -1){//prepare BOM 
            if (upper(functionName) == "CONTRIBUTE" and (sourceItem == targetItem) and findinarray(conditionMet, false) == -1) {

                bomKey = targetItem + "#" + actionCondition;
                if (findinarray(duplicateBOMItems, bomKey) == -1) {
                    bomItem = json();
                    jsonput(bomItem, "appliedRuleId", ruleId);
                    jsonput(bomItem, "partNumber", targetItem);
                    jsonput(bomItem, "itemPath", actionCondition);
                    if (isnumber(multiplier)) {
                        jsonput(bomItem, "quantity", multiplier);
                    } else {
                        jsonput(bomItem, "quantity", 1);
                    }

                    jsonarrayappend(bomItemsArray, bomItem);
                    append(duplicateBOMItems, bomKey);
                }
                continue;

            }
            jsonarrayappend(condArr, condObj);
            jsonput(ruleObj, "conditions", condArr);
