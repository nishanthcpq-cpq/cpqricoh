////print optionFeatures;
indexes = range(jsonarraysize(items));
for i in indexes {
    itemPath = jsonarrayget(itemsPaths, i);
    Isbundle = jsonarrayget(bundlesPaths, i);
    itemFound = true;
    ////print typeOfProduct ;
    ////print jsonarrayget(items,i);
    ////print Isbundle ;
    if (find(itemPath, ".") <> -1) {
        tempItemArr = split(itemPath, ".");
        for eachItem in tempItemArr {
            itemFound = itemFound and findinarray(options, eachItem) <> -1;
            if (findinarray(selectedItems, eachItem) == -1) {
                append(selectedItems, eachItem);
            }
        }
    } else {
        itemFound = itemFound and findinarray(options, itemPath) <> -1;
    }
    if (itemFound OR (typeOfProduct == "BUNDLEDPRODUCT" and Isbundle == "Y")) { //ex:  ADDITIONAL UNIT will not be found in parts db
        ////print jsonarrayget(items,i);
        bomItem = json();
        jsonput(bomItem, "appliedRuleId", "");
        jsonput(bomItem, "partNumber", jsonarrayget(items, i));
        jsonput(bomItem, "itemPath", jsonarrayget(itemsPaths, i) + "." + jsonarrayget(items, i));
        if (Isbundle == "Y" and find(jsonarrayget(itemsPaths, i), " ") <> -1) {
            jsonput(bomItem, "itemPath", configureItem + "." + jsonarrayget(items, i)); //defect 61- bundle path issue//RICOH HWAAS BUNDLES.//printINONE-IMC4510-ADV
        }


        if (isnumber(jsonarrayget(quantities, i))) {
            jsonput(bomItem, "quantity", jsonarrayget(quantities, i));
        } else {
            jsonput(bomItem, "quantity", 1);
        }
        jsonput(bomItem, "IsBundle", Isbundle);

        //jsonput(bomItem,"parentItem",actionCondition);
        jsonarrayappend(bomItemsArray, bomItem);
    } else {
        append(optionFeatures, itemPath);
    }
}

// =====================================================================================
// CHG0097681 ADDITION - Preowned / Serialized unit guard
// If the current selection is a preowned item carrying a Serial_Number, the EBS rules
// engine simulation below (recommendations / AutoUnSelect / WaningMessages /
// constraintMessages) must NOT run - a serialized preowned unit is a fixed, already
// configured asset, not something the rule engine should re-derive recommendations for.
// BOM construction above still runs normally; only the rules-engine block below is skipped.
// =====================================================================================
defaultsAndMessages = json();
attributeValJSON = json(userSelections);
Serial_Number = "";
selectedPreownedObj = jsonget(attributeValJSON, "selectedPreowned", "string", "");
if (selectedPreownedObj <> "" AND not(isnull(selectedPreownedObj))) {
    Serial_Number = jsonget(json(selectedPreownedObj), "Serial_Number", "string", "");
}
isPreownedSerialSelected = (Serial_Number <> "");

if (NOT isPreownedSerialSelected) {
    ////print bomItemsArray;
    ////print "optionFeaturesoptionFeatures";
    ////print optionFeatures;
    evalRuleDict = dict("boolean");
    ////print selectedItems;
    ////print itemsPaths ;
    contributeRulesObj = json(); //defect#82 Model IMC4510 :  account specific accessories items are adding to BOM after update
    contributeRulesArr = jsonarray(); //defect#82 Model IMC4510 :  account specific accessories items are adding to BOM after update
    rulesData = json();
    relationshipJSON = json();
    relationshipJSONArray = jsonarray();
    messageRuleIDs = string[];
    modelname1 = upper(modelName);
    rowCount = 0;

    //   defect#34434 to trigger rule : ChooseAccount is SourceItem
    choosenaccount = jsonpathgetsingle(userSelectionsJSON, "$.selectedAccount");
    if (choosenaccount <> "" AND (NOT isnull(choosenaccount))) {
        append(selectedItems, choosenaccount);
    }
    // --> defect#34434 end

    /* query the CDL Rules for the current model*/
    recordSet = bmql("select *  from $datatable where (ModelName = $modelName OR ModelName = $modelName1) and (BaseModel = $baseModel OR BaseModel IS NULL) and (IsActive = 'Y' OR IsActive IS NULL)"); //removed order by as it causes query limit to 1000recs
    //recordSet = bmql("select *  from $datatable where (ModelName = $modelName OR ModelName = $modelName1) and (BaseModel = $baseModel OR BaseModel IS NULL) and (IsActive = 'Y' OR IsActive IS NULL) order by RuleID ,ConditionID");
    for rec in recordSet {
        rowCount = rowCount + 1;
        ruleID = get(rec, "RuleID");
        //if(ruleID <> "11" and ruleID <> "121"){continue;}
        //if(ruleID <> "13"){continue;}
        //if(ruleID == "181" and modelname1 == "IMC2510"){continue;}
        ruleObj = jsonget(rulesData, ruleID, "json", json());
        condID = get(rec, "ConditionID");
        sourceItem = get(rec, "SourceItem");
        targetItem = get(rec, "TargetItem");
        functionName = get(rec, "Condition_Function");
        //if(typeOfProduct == "BUNDLEDPRODUCT" and (upper(functionName) <> "CONTRIBUTE" and (sourceItem == targetItem))){
        if (typeOfProduct == "BUNDLEDPRODUCT" and upper(functionName) <> "CONTRIBUTE") { //defect 61 - Model IMC4510 >> Bundle Error message(DEVICE IMPLIES PAPER FEED UNIT PB3320, 423699, LCIT PB3330, 419374, OR CABINET TYPE A5, 52721.) appears on the screen.
            continue;
        }
        conditions = get(rec, "Conditions");
        sourceItem = get(rec, "SourceItem");
        targetItem = get(rec, "TargetItem");
        multiplier = get(rec, "Multiplier");
        defaultRule = get(rec, "DefaultRule"); //03/02/2026 added for C014
        operator = get(rec, "Operator");
        actionFunction = get(rec, "Action_Function");
        actionCondition = get(rec, "Action_Conditions");
        startDate = get(rec, "StartDate");
        endDate = get(rec, "EndDate");
        startDate_str = startDate;
        endDate_str = endDate;
        if (startDate <> "") {
            tempStartArr = split(startDate, "-");
            if (len(tempStartArr[1]) == 3) {
                inputStartDate = strtodate(startDate, "dd-MMM-yy");
                startDate_str = datetostr(inputStartDate, "dd/MM/yyyy");
            } else {
                inputStartDate = strtodate(startDate, "dd-mm-yyyy");
                startDate_str = datetostr(inputStartDate, "dd/MM/yyyy");
            }

        }
        if (endDate <> "") {
            tempEndArr = split(endDate, "-");
            if (len(tempEndArr[1]) == 3) {
                inputEndDate = strtodate(endDate, "dd-MMM-yy");
                endDate_str = datetostr(inputEndDate, "dd/MM/yyyy");
            } else {
                inputEndDate = strtodate(endDate, "mm-dd-yyyy");
                endDate_str = datetostr(inputEndDate, "dd/MM/yyyy");
            }

        }
        if (util.validateDates(startDate_str, endDate_str, getdate())) {
            jsonput(ruleObj, "ruleId", ruleID);
            jsonput(ruleObj, "functionName", upper(functionName));
            jsonput(ruleObj, "actionFunctionName", upper(actionFunction));
            jsonput(ruleObj, "operator", upper(operator));
            jsonput(ruleObj, "multiplier", multiplier);
            jsonput(ruleObj, "ErrorMessage", get(rec, "ErrorMessage"));
            jsonput(ruleObj, "exludedItems", ""); //dummy...will be used in chainRules
            jsonput(ruleObj, "defaultRule", defaultRule); //03/02/2026 added for C014
            sourceItemsStr = jsonget(ruleObj, "sourceItems", "string", "");
            /*if(sourceItems == ""){
            	sourceItems = sourceItem;		
            }else{
            	sourceItems = sourceItems + "#" + sourceItem;
            }*/
            sourceItems = split(sourceItemsStr, "#");
            if (findinarray(sourceItems, sourceItem) == -1 and sourceItemsStr == "") {
                //append(sourceItems,sourceItem);
                sourceItemsStr = sourceItem;
            } elif (findinarray(sourceItems, sourceItem) == -1 and sourceItemsStr <> "") {
                //append(sourceItems,sourceItem);
                sourceItemsStr = sourceItemsStr + "#" + sourceItem;
            }
            targetItemsStr = jsonget(ruleObj, "targetItems", "string", "");
            /*if(targetItems == ""){
            	targetItems = sourceItem;		
            }else{
            	targetItems = targetItems + "#" + targetItem;
            }*/
            targetItems = split(targetItemsStr, "#");
            if (findinarray(targetItems, targetItem) == -1 and targetItemsStr == "") {

                targetItemsStr = targetItem;
            } elif (findinarray(targetItems, targetItem) == -1 and targetItemsStr <> "") {

                targetItemsStr = targetItemsStr + "#" + targetItem;
            }
            jsonput(ruleObj, "sourceItems", sourceItemsStr);
            jsonput(ruleObj, "targetItems", targetItemsStr);
            //jsonput(ruleObj,"sourceItems",join(sourceItems,"#"));
            //jsonput(ruleObj,"targetItems",join(targetItems,"#"));

            /*if (findinarray(selectedItems, sourceItem) <> -1 OR
            	findinarray(selectedItems, targetItem) <> -1 OR
            	findinarray(optionFeatures, sourceItem) <> -1 OR
            	findinarray(optionFeatures, targetItem) <> -1 OR
            	(upper(operator) == "EXCLUDES" AND selectedAccount <> "" AND find(UPPER(sourceItem), "CHOOSE ACCOUNT") <> -1) OR
            	(upper(operator) == "EXCLUDES" AND selectedAccount <> "" AND find(UPPER(targetItem), "CHOOSE ACCOUNT") <> -1)
            ) {
            	jsonput(ruleObj, "executeRule", true);
            }
            */
            condArr = jsonget(ruleObj, "conditions", "jsonarray", jsonarray());

            condObj = json();
            jsonput(condObj, "conditionId", condID);
            jsonput(condObj, "sourceConditions", conditions);

            jsonput(condObj, "actionConditions", actionCondition);

            jsonput(condObj, "sourceItem", sourceItem);
            jsonput(condObj, "targetItem", targetItem);
            duplicatePathCheck = "$..conditions[?(@.sourceConditions == '" + conditions + "')]";
            if (NOT jsonpathcheck(ruleObj, duplicatePathCheck)) { //to know unique sources//Defect #28812 issue5, rule#275 >> 123,  to no of selected items
                jsonput(condObj, "firstOccurance", true);
            }
            //jsonput(condObj ,"isExluded",false);//dummy...will be used in chainRules
            jsonput(condObj, "isSourceExluded", false); //dummy...will be used in chainRules
            jsonput(condObj, "isTargetExluded", false); //dummy...will be used in chainRules

            jsonput(condObj, "sourceConditionLevel", "");
            if (findinarray(rulePathsArr, conditions) <> -1) {
                jsonput(condObj, "sourceConditionLevel", "Y");
            }
            jsonput(condObj, "targetConditionLevel", "");
            if (findinarray(rulePathsArr, actionCondition) <> -1) {
                jsonput(condObj, "targetConditionLevel", "Y");
            }

            sourceArraysetFound = false;
            targetArraysetFound = false;
            sourceConditionsArr = split(conditions, ".");
            ////print "conditions-->"+conditions;
            condStr = "";
            condStr2 = "";
            conditionMet = boolean[];
            sourceItemarrayset = "";

            for sourceCondition in sourceConditionsArr { //eval the source condition

                found = false;
                if (condStr == "") {
                    condStr = sourceCondition;
                    if (endswith(trim(sourceCondition), "OPTION CLASS")) {
                        condStr2 = trim(replace(sourceCondition, "OPTION CLASS", ""));
                    } else {
                        condStr2 = sourceCondition;
                    }
                } else {
                    condStr = condStr + "." + sourceCondition;
                    if (endswith(trim(sourceCondition), "OPTION CLASS")) {
                        condStr2 = condStr2 + "." + trim(replace(sourceCondition, "OPTION CLASS", ""));
                    } else {
