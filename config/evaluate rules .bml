        }*/
        endTime11 = getcurrenttimeinmillis();
        //logTime("Rules New - Eval First lopp",endTime11-startTime11);
        startTime11 = getcurrenttimeinmillis();
        /*if(upper(functionName) <>  "CONTRIBUTE"){
        	jsonpathset(relationshipJSON,"$..relatedRules[?(@.ruleId == '"+ruleID+"')].sourceItems",join(sourceItems,"#"));
        	jsonpathset(relationshipJSON,"$..relatedRules[?(@.ruleId == '"+ruleID+"')].targetItems",join(targetItems,"#"));
        	//jsonpathset(relationshipJSON,"$..relatedRules[?(@.ruleId == '"+ruleID+"')].targetItems",join(targetItems,"#"));

        }*/
        if (NOT executeRule) {
            continue;
        }
        message = stringbuilder();
        sourceConditionMet = false;
        targetConditionMet = false;
        ////print targetConditionMetArr;
        if (functionName == "CONTRIBUTE" and findinarray(sourceConditionMetArr, true) <> -1) {
            sourceConditionMet = true;

        }
        if (functionName == "CONTRIBUTE" and findinarray(targetConditionMetArr, true) <> -1) {
            targetConditionMet = true;

        }
        if (functionName == "ANYTRUE" and findinarray(sourceConditionMetArr, true) <> -1) {
            sourceConditionMet = true;
            if (ruleId == "2") {
                print "rule passed here";
            }
            //sbappend(message,"Please select one of the items(",itemsForMessage,")");
        }
        if (functionName == "ALLTRUE" and findinarray(sourceConditionMetArr, false) == -1) {
            sourceConditionMet = true;
        }
        if (actionFunctionName == "ANYTRUE" and findinarray(targetConditionMetArr, true) <> -1) {
            targetConditionMet = true;
        }
        if (actionFunctionName == "ALLTRUE" and findinarray(targetConditionMetArr, false) == -1) {
            targetConditionMet = true;
        }
        conditionMet = false;
        if (sourceConditionMet and targetConditionMet) {
            conditionMet = true;
        }
        targetItems_size = sizeofarray(targetItems);
        sourceItems_size = sizeofarray(sourceItems);
        messagesArr = string[];
        for i in indexes {
            conditionObj = jsonarrayget(conditionsArr, i, "json");

            ////print conditionObj ;
            condID = jsonget(conditionObj, "conditionId", "string");
            sourceIndex = jsonget(conditionObj, "sourceIndex", "string");
            targetIndex = jsonget(conditionObj, "targetIndex", "string");
            sourceItem = jsonget(conditionObj, "sourceItem", "string");
            targetItem = jsonget(conditionObj, "targetItem", "string");
            target_check_item = jsonget(conditionObj, "targetItem", "string", "");
            sourceAttribute = jsonget(conditionObj, "sourceAttribute", "string");
            targetAttribute = jsonget(conditionObj, "targetAttribute", "string");
            //checking in unselection rules array to ignore
            unselectionpath = "$..unselected_rules[?((@.targetAttribute == '" + sourceAttribute + "' && @.targetIndex =='" + sourceIndex + "'))]";
            if (jsonpathcheck(unselection_json, unselectionpath) AND mainunit_arrayset <> targetAttribute AND sourceIndex <> "" AND NOT ISnull(sourceIndex)) {
                continue;
            }
            // added for 28110 to ignore main unit rule if main unit is target
            if (mainunit_arrayset == targetAttribute) {
                continue;
            }
            sourceCondition = jsonget(conditionObj, "sourceConditions", "string");
            actionCondition = jsonget(conditionObj, "actionConditions", "string");
            multiplier = jsonget(conditionObj, "multiplier", "string");
            sourceSelected = jsonget(conditionObj, "sourceConditionMet", "boolean", false);
            targetSelected = jsonget(conditionObj, "targetConditionMet", "boolean", false);
            ////print conditionMet ;
            ////print operator ;
            ////print actionFunctionName ;
            ////print targetItems;
            ////print targetConditionMet ;
            recommendations = jsonget(defaultsAndMessages, "recommendations", "jsonarray", jsonarray());
            sourceItemFound = jsonpathcheck(masterStringJSON, "$..[?(@.partNumber == '" + sourceItem + "')]");
            targetItemFound = jsonpathcheck(masterStringJSON, "$..[?(@.partNumber == '" + targetItem + "')]");
            setRec = false;
            setType = "set";
            value = true;
            applySourceSelection = false;
            applyTargetSelection = false;
            applyTargetExclusion = false;
            applySourceExclusion = false;
            showMessage = false;
            combination_rule = false;
            //added for default rule behaviour ticket 28110---start
            default_ovveride_check = false;
            default_ovveride_path = jsonpathcheck(constraintAndRecStringJson, "$.defaultsAndMessages.recommendations[?(@.appliedRuleId =='" + ruleId + "')]");
            //if(default_ovveride_path AND operator == "DEFAULTS")
            if (default_ovveride_path AND operator == "DEFAULTS" AND targetItemFound == true) {
                unselectionpath_traget = "$..unselected_rules[?((@.targetAttribute == '" + targetAttribute + "' && @.targetIndex =='" + targetIndex + "'))]";
                if (targetSelected == false OR jsonpathcheck(unselection_json, unselectionpath_traget)) {
                    default_ovveride_check = true;
                }
            }
            if (default_ovveride_check == false AND operator == "DEFAULTS") {
                if (sourceConditionMet and sourceSelected and (sizeofarray(targetItems) == 1)) {
                    applyTargetSelection = true;
                } elif (sourceConditionMet and sourceSelected) {
                    applyTargetSelection = true;
                }
            }
            //-----------------end	

            //if((operator == "IMPLIES" OR operator == "REQUIRES" ) and sourceConditionMet and sourceSelected and (sizeofarray(targetItems) == 1)){
            if ((operator == "IMPLIES" OR operator == "REQUIRES" OR (operator == "TO" and (sourceItem <> targetItem))) and sourceConditionMet and sourceSelected and (sizeofarray(targetItems) == 1)) {
                applyTargetSelection = true;
            } elif (((operator == "IMPLIES" AND actionFunctionName == "ALLTRUE")) and sourceConditionMet and sourceSelected) {
                applyTargetSelection = true;
            } elif (operator == "REQUIRES" and targetConditionMet and targetSelected and not sourceConditionMet) {
                applySourceSelection = true;
            } elif (operator == "IMPLIES" and sourceConditionMet and sourceSelected and not targetConditionMet and sizeofarray(targetItems) > 1 and actionFunctionName == "ANYTRUE") {
                /*if(n-1 are excluded){
                	auto select the non excluded item
                }elif(not targetConditionMet){
                	Show message
                }*/
                showMessage = true;
            } elif (operator == "IMPLIES" and sourceConditionMet and sourceSelected and sizeofarray(targetItems) > 1 and actionFunctionName == "ALLTRUE") {
                applyTargetSelection = true;
            } elif (operator == "EXCLUDES" and functionName == "ANYTRUE" and sourceConditionMet and sourceSelected and actionFunctionName == "ANYTRUE") {

                //if(ruleId == "2"){
                //print "Condition Satisfied";
                //}
                applyTargetExclusion = true;
            } elif (operator == "EXCLUDES" and functionName == "ANYTRUE" and targetConditionMet and targetSelected and actionFunctionName == "ANYTRUE") {
                applySourceExclusion = true;
            } elif (operator == "EXCLUDES" and functionName == "ALLTRUE" and sourceConditionMet and sourceSelected and actionFunctionName == "ANYTRUE") {
                applyTargetExclusion = true;
                if (sizeofarray(sourceItems) > 1 and sizeofarray(targetItems) > 1) {
                    combination_rule = true;
                }
            } elif (operator == "EXCLUDES" and functionName == "ALLTRUE" and targetConditionMet and targetSelected and actionFunctionName == "ANYTRUE") {
                /*sourcestr_path="$."+ruleId+".sourceItems";
                if(jsonpathcheck(rulesData,sourcestr_path))
                {
                	sourcestr=jsonpathgetsingle(rulesData,sourcestr_path,"string","");				
                	source_arr=split(sourcestr,"#");
                	if(sizeofarray(source_arr)==1)
                	{
                	   applySourceExclusion = true;//AllTrue(A) Excludes AnyTrue(C,D)--> when c od selected A needs to excluded
                	}
                }*/
                //print "herrrrr"+ruleId;
                //print sizeofarray(sourceItems);
                //print selectedItemCount ;
                //print sourceSelected;
                if (sizeofarray(sourceItems) > 1 and sizeofarray(targetItems) > 1) {
                    combination_rule = true;
                }
                if ((sizeofarray(sourceItems) - 1) == selectedItemCount and Not sourceSelected) { ////Defect #28546 rule#5, When any 2 Paper Feed Units are selected, 52006, TALL CABINET TYPE Q should be excluded, but is not happening in CPQ. if n-1 are selected, and any target item was already selected then excluded remaining one source item
                    applySourceExclusion = true;
                    //print "blank";
                }
                if (sizeofarray(sourceItems) == 1) {
                    applySourceExclusion = true; //AllTrue(A) Excludes AnyTrue(C,D)--> when c od selected A needs to excluded
                }
                //applySourceExclusion = true;//AllTrue(A,B) Excludes AnyTrue(C,D)
                print "When C or/and D excluded A Will be available for selection";
            } elif (operator == "EXCLUDES" and functionName == "ANYTRUE" and sourceConditionMet and sourceSelected and actionFunctionName == "ALLTRUE") {
                //applyTargetExclusion = true; Srini commented on 0914
                //---------------
                //srini added on 0914------start 
                targetItems_size = sizeofarray(targetItems);
                if ((targetItems_size == 1 or (targetItems_size > 1 and targetItems_size - 1 == targetselectedItemCount)) and not(targetSelected) and findinarray(selectedItems, targetItem) == -1) {
                    applyTargetExclusion = true;
                }
            }

            //srini added on 0914------end
            elif (operator == "EXCLUDES" and functionName == "ANYTRUE" and targetConditionMet and targetSelected and actionFunctionName == "ALLTRUE") {
                // previously applySourceExclusion is comment for rule id 232 of  IMC2510 model is uncommented
                //applySourceExclusion = true;
                if (targetselectedItemCount == targetItems_size) {
                    applySourceExclusion = true;
                }
                print "No action required";
            } elif (operator == "EXCLUDES" and functionName == "ALLTRUE" and sourceConditionMet and sourceSelected and actionFunctionName == "ALLTRUE") {
                //applyTargetExclusion = true;
                targetItems_size = sizeofarray(targetItems);
                if (((targetItems_size == 1 or (targetItems_size > 1 and targetItems_size - 1 == targetselectedItemCount)) and not(targetSelected) and findinarray(selectedItems, targetItem) == -1)) {
                    applyTargetExclusion = true;
                }
            } elif (operator == "EXCLUDES" and functionName == "ALLTRUE" and targetConditionMet and targetSelected and actionFunctionName == "ALLTRUE") {
                //applySourceExclusion = true;
                if ((targetselectedItemCount == targetItems_size) and (sourceItems_size == 1 or sourceItems_size - 1 == selectedItemCount) and not(sourceSelected) and findinarray(selectedItems, sourceItem) == -1) {
                    applySourceExclusion = true;
                }
                print "No action required";
            }

            if (applySourceExclusion or applyTargetExclusion) {
                setType = "forceSet";
                value = false;
                setRec = true;
            }
            if (applyTargetSelection) {
                setType = "set";
                value = true;
                setRec = true;
            }
            if (default_ovveride_check) {
                setType = "set";
                value = false;
                setRec = true;
            }
            //print "setRecsetRecsetRec";
            ////print operator ;
            //print sourceConditionMet ;
            ////print targetConditionMet ;
            ////print targetSelected ;

            ////print functionName ;
            ////print actionFunctionName ;
            ////print setRec;
            ////print "----------------------";

            if (setRec) {
                //print "==============="+ruleId;
                //print applySourceExclusion ;
                //print applyTargetExclusion;
                if ((isnull(targetIndex) OR targetIndex == "") and NOT isnull(targetAttribute) and (targetAttribute <> "") and jsonpathcheck(masterStringJSON, "$." + targetAttribute)) {

                    ////print "insideeeeeee";
                    itemsJsonArr = jsonpathgetsingle(masterStringJSON, "$." + targetAttribute, "jsonarray", jsonarray());
                    ////print itemsJsonArr ;
                    if (jsonarraysize(itemsJsonArr) <= 1 and find(actionCondition, ".") == -1) { //Defect 30208, added find condition
                        targetIndex = "0";
                    }
                }
                if (operator == "EXCLUDES" and isnull(targetAttribute) and findinarray(stepNamesArr, actionCondition) == -1 and actionCondition <> "CHOOSE ACCOUNT") { //IMC4510 rule#92 dont run bundle rule for regular model vice versa.

                    continue;
                }
                if (operator == "EXCLUDES" and isnull(sourceAttribute) and findinarray(stepNamesArr, sourceCondition) == -1 and sourceCondition <> "CHOOSE ACCOUNT") { //IMC4510 rule#92 dont run regular model rules for bundle vice versa.

                    continue;
                }
                if (isnull(targetAttribute) or targetAttribute == "null") {

                    targetAttribute = "";
                }
                if (isnull(sourceAttribute) or sourceAttribute == "null") {
                    sourceAttribute = "";
                }
                recommendations = jsonget(defaultsAndMessages, "recommendations", "jsonarray", jsonarray());
                if (findinarray(chainRuleIds, ruleId) == -1) {
                    append(chainRuleIds, ruleId);
                    append(ToBeAppliedRuleIds, ruleID);
                }
                recommendation = json();
                jsonput(recommendation, "appliedRuleId", ruleId);
                jsonput(recommendation, "operator", operator);
                jsonput(recommendation, "functionName", functionName);
                jsonput(recommendation, "actionFunctionName", actionFunctionName);
                jsonput(recommendation, "setType", setType);
                jsonput(recommendation, "value", value);
                jsonput(recommendation, "sourceIndex", sourceIndex);
                jsonput(recommendation, "targetIndex", targetIndex);
                jsonput(recommendation, "sourceAttribute", sourceAttribute);
                jsonput(recommendation, "targetAttribute", targetAttribute);
                jsonput(recommendation, "sourceConditions", sourceCondition);
                jsonput(recommendation, "actionConditions", actionCondition);
                jsonput(recommendation, "defaultRule", defaultRule); //03/02/2026 added for C014
                jsonput(recommendation, "combination_rule", combination_rule);
                //checking in unselection rules array to ignore
                if (applyTargetSelection and NOT Isnull(targetIndex) and targetIndex <> "") {
                    //Anytrue(A) implies Anytrue(C)
                    //Anytrue(B) implies Anytrue(C) // C Deselected but should be set to true again because A is still selected
                    setPath = "$..unselected_rules[?((@.targetAttribute == '" + targetAttribute + "' && @.targetIndex =='" + targetIndex + "'))].value";
                    setImpactRulePath = "$..unselected_rules[?((@.targetAttribute == '" + targetAttribute + "' && @.targetIndex =='" + targetIndex + "'))].ImpactedByRuleId";
                    if (jsonpathcheck(unselection_json, setPath)) {
                        jsonpathset(unselection_json, setImpactRulePath, ruleId);
                    }
                }

                //Added on 01-19-2026--> to restore the chain rule path which is used for unselction
                chainrulepath = "$.defaultsAndMessages.recommendations[?(@.appliedRuleId == '" + ruleID + "'&& @.targetIndex == '" + targetIndex + "' && @.targetAttribute == '" + targetAttribute + "')].chainRule";
                if (jsonpathcheck(constraintAndRecStringJson, chainrulepath)) {
                    chainRulejs1 = jsonpathgetmultiple(constraintAndRecStringJson, chainrulepath);
                    //jsonput(recommendation ,"chainRule",jsonpathgetsingle(constraintAndRecStringJson,chainrulepath));
                    jsonput(recommendation, "chainRule", jsonarrayget(chainRulejs1, 0));
                }

                if (applySourceSelection) {
                    jsonput(recommendation, "sourceIndex", targetIndex);
                    jsonput(recommendation, "targetIndex", sourceIndex);
                    jsonput(recommendation, "sourceAttribute", targetAttribute);
                    jsonput(recommendation, "targetAttribute", sourceAttribute);
                    //jsonput(recommendation ,"sourceConditions",actionCondition);
                    //jsonput(recommendation ,"actionConditions",sourceCondition);
                }

                //AnyTrue(A) Excludes AnyTrue(C)
                //AnyTrue(A) Excludes AnyTrue(C, D)				
                //AnyTrue(A,B) Excludes AnyTrue(C)
                //AnyTrue(A, B) Excludes AnyTrue(C, D)

                if (applyTargetExclusion) {
                    jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + actionCondition + "')].isSourceExluded", true);
                    jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + actionCondition + "')].isTargetExluded", true);
                    jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + actioncondition + "')].isSourceExluded", true);
                    jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + actioncondition + "')].isTargetExluded", true);
                    append(ToBeAppliedRuleIds, ruleId + "#" + sourceCondition + "#" + actionCondition); //DEFECT 28837 - on update chain rules become recursive PRO15000CKMA - Item 1205NJ0UN3 - Rule 21 > > 17  but on update 21 become child rule to 17. 17>> 21 because 17 is executed first in the chain rule loop , so no entry for 21 rule already hence this issue occured

                }
                if (applySourceExclusion) { //All Direct Exclusion rules are bi-directional

                    jsonput(recommendation, "sourceIndex", targetIndex);
                    jsonput(recommendation, "targetIndex", sourceIndex);
                    jsonput(recommendation, "sourceAttribute", targetAttribute);
                    jsonput(recommendation, "targetAttribute", sourceAttribute);
                    jsonput(recommendation, "sourceConditions", actionCondition);
                    jsonput(recommendation, "actionConditions", sourceCondition);

                    jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + sourceCondition + "')].isSourceExluded", true);
                    jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + sourceCondition + "')].isTargetExluded", true);
                    jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + sourcecondition + "')].isSourceExluded", true);
                    jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + sourcecondition + "')].isTargetExluded", true);
                    append(ToBeAppliedRuleIds, ruleId + "#" + actionCondition + "#" + sourceCondition); //DEFECT 28837 - on update chain rules become recursive PRO15000CKMA - Item 1205NJ0UN3 - Rule 21 > > 17  but on update 21 become child rule to 17. 17>> 21 because 17 is executed first in the chain rule loop , so no entry for 21 rule already hence this issue occured
                }
                //All Direct Exclusion rules are bi-directional			
                //Added for warning messages for override --Start
                tempsourceConditions = jsonget(recommendation, "sourceConditions", "string", "");
                if (tempsourceConditions <> "") {
                    sarr = split(tempsourceConditions, ".");
                    sarr = reverse(sarr);
                    hovermessage = "Selecting this item will automatically restrict the availability of item " + sarr[0] + " and any other dependent items.";
                    //hovermessage=ErrorMessage;
                    jsonput(recommendation, "Message", hovermessage);
                }
                //17/02/2025 added for C014
                if (defaultRule == "Y") {
                    defaultMsg = "";
                    if (operator == "EXCLUDES") {
                        defaultMsg = "This item cannot be added to this Model if you need this accessory select a different Model";
                    } else {
                        defaultMsg = "This item is required to be added to this Model";
                    }
                    jsonput(recommendation, "Message", defaultMsg);
                }
                //------------------Building messages for Warning message--Start
                sourceConditionMsg = jsonget(recommendation, "sourceConditions", "string", "");
                actionConditionMsg = jsonget(recommendation, "actionConditions", "string", "");
                targetIndexMsg = jsonget(recommendation, "targetIndex", "string", "");
                sourceIndexMsg = jsonget(recommendation, "sourceIndex", "string", "");
                //28950
                if (targetIndexMsg <> "" AND sourceIndexMsg <> "" AND operator <> "DEFAULTS") {

                    targetAttributeMsg = jsonget(recommendation, "targetAttribute");
                    sourceAttributeMsg = jsonget(recommendation, "sourceAttribute");
                    descPath = "$." + sourceAttributeMsg + "[?(@.index == '" + sourceIndexMsg + "')].partDescription";
                    actionDescPath = "$." + targetAttributeMsg + "[?(@.index == '" + targetIndexMsg + "')].partDescription";
                    actionDesc = "";
                    actionPartNumber = "";
                    description = "";
                    srcPartNumber = "";

                    targetPath = targetAttributeMsg + "_" + targetIndexMsg;
                    sourcePath = sourceAttributeMsg + "_" + sourceIndexMsg;
                    targetKey = actionConditionMsg;
                    sourceKey = sourceConditionMsg;
                    unSelOverrideMsg = json();
                    jsonput(unSelOverrideMsg, "ruleId", ruleId);
                    jsonput(unSelOverrideMsgs, targetKey + "#" + sourceKey, unSelOverrideMsg);
                    jsonput(unSelOverrideMsgs, sourceKey + "#" + targetKey, unSelOverrideMsg);
                    jsonput(unSelOverrideMsgs, sourceKey + "path", sourcePath);
                    jsonput(unSelOverrideMsgs, targetKey + "path", targetPath);
                    if (jsonpathcheck(masterStringJSON, descPath)) {
                        partNumber = jsonpathgetsingle(masterStringJSON, "$." + sourceAttributeMsg + "[?(@.index =='" + sourceIndexMsg + "')].partNumber");
                        desc = jsonpathgetsingle(masterStringJSON, descPath);
                        descArr = split(desc, "\n");
                        description = partNumber + " " + descArr[0];
                    }
                    jsonput(unSelOverrideMsgs, sourceKey, description);
                    if (jsonpathcheck(masterStringJSON, actionDescPath)) {
                        actionPartNumber = jsonpathgetsingle(masterStringJSON, "$." + targetAttributeMsg + "[?(@.index == '" + targetIndexMsg + "')].partNumber");
                        desc = jsonpathgetsingle(masterStringJSON, actionDescPath);
                        descArr = split(desc, "\n");
                        actionDesc = actionPartNumber + " " + descArr[0];
                    }
                    jsonput(unSelOverrideMsgs, targetKey, actionDesc);

                }
                //------------------Building messages for Warning message--END			
                //------end
                jsonarrayappend(recommendations, recommendation);
                jsonput(defaultsAndMessages, "recommendations", recommendations);
                ////print "hereee:";
                if (applyTargetSelection) { //add items to BOM list
                    bomKey = targetItem + "#" + actionCondition;
                    ////print duplicateBOMItems;
                    if (findinarray(duplicateBOMItems, bomKey) == -1) {
                        bomItem = json();
                        jsonput(bomItem, "appliedRuleId", ruleId);
                        jsonput(bomItem, "partNumber", targetItem);
                        pathFound = jsonpathcheck(contributeRulesObj, "$..contributeRules[?(@.sourceConditions == '" + actionCondition + "')].actionConditions");
                        ////print actionCondition;
                        ////print pathFound;
                        ////print contributeRulesObj;
                        // commented by Gandeev(27/10/2025) because the css and rules are not working 
                        /*if(pathFound and find(actionCondition," ") <> -1){
                        	itemPath = jsonpathgetsingle(contributeRulesObj,"$..contributeRules[?(@.sourceConditions == '"+actionCondition+"')].actionConditions");
                        	jsonput(bomItem,"itemPath",itemPath);
                        }else{
                        	jsonput(bomItem,"itemPath",actionCondition);
                        }*/
                        // added by Gandeev(27/10/2025) because the css and rules are not working  <---- Start ---->
                        if (pathFound and find(actionCondition, " ") <> -1) {
                            if (jsonpathcheck(contributeRulesObj, "$..contributeRules[?(@.sourceConditions == '" + actionCondition + "'&& @.ruleId =='" + ruleId + "')]")) {
                                itemPath = jsonpathgetsingle(contributeRulesObj, "$..contributeRules[?(@.sourceConditions == '" + actionCondition + "' && @.ruleId =='" + ruleId + "')].actionConditions");
                                jsonput(bomItem, "itemPath", itemPath);
                            }

                        } else {
                            jsonput(bomItem, "itemPath", actionCondition);
                        }
                        // added by Gandeev(27/10/2025) because the css and rules are not working  <---- End ---->
                        if (targetAttribute <> "") { //added as part of qty changes	

                            quantity = jsonpathgetsingle(userSelectionsJSON, "$.attributeAndValues[?(@.arraySet == '" + targetAttribute + "' && @.item == '" + targetItem + "')].quantity", "integer", 1);
                            if (quantity == 0) {
                                quantity = 1;
                            }
                            jsonput(bomItem, "quantity", quantity);
                        } else {
                            if (isnumber(multiplier)) {
                                jsonput(bomItem, "quantity", multiplier);
                            } else {
                                jsonput(bomItem, "quantity", 1);
                            }
                        }
                        jsonarrayappend(bomItemsArray, bomItem);
                        append(duplicateBOMItems, bomKey);
                    }
                    append(ToBeAppliedRuleIds, ruleId + "#" + sourceCondition + "#" + actionCondition); //DEFECT 28837 - on update chain rules become recursive PRO15000CKMA - Item 1205NJ0UN3 - Rule 21 > > 17  but on update 21 become child rule to 17. 17>> 21 because 17 is executed first in the chain rule loop , so no entry for 21 rule already hence this issue occured

                    jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + actionCondition + "')].sourceConditionMet", true);
                    jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + actionCondition + "')].targetConditionMet", true);

                    jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + actionCondition + "')].sourceSelected", true);
                    jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + actionCondition + "')].targetSelected", true);
                    if (actionCondition <> "" and find(actionCondition, ".") <> -1) { //Defect #28812 issue5, rule#275 CONFIGURE EQUIPMENT.ADDITIONAL UNIT FOR 7605.S 5DR SATELLITE LOCKER (LARGE LOCKERS).9P39750 [1ST ADDITIONAL UNIT] . some rules(123) has target 9P39750 [1ST ADDITIONAL UNIT] without path
                        actionConditionArr = split(actionCondition, ".");
                        selectedItem = actionConditionArr[sizeofarray(actionConditionArr) - 1];
                        jsonpathset(rulesData, "$..conditions[?(@.sourceConditions == '" + selectedItem + "')].sourceConditionMet", true);
                        jsonpathset(rulesData, "$..conditions[?(@.actionConditions == '" + selectedItem + "')].targetConditionMet", true);

                        jsonpathset(relationshipJSON, "$..relatedRules[?(@.sourceConditions == '" + selectedItem + "')].sourceSelected", true);
                        jsonpathset(relationshipJSON, "$..relatedRules[?(@.actionConditions == '" + selectedItem + "')].targetSelected", true);
                    }
                }

            }
            if (showMessage) { //ANYTRUE with multiple targets

                if (findinarray(messageRuleIDs, ruleId) == -1) {
                    append(messageRuleIDs, ruleId);
                }

            }

        }
        endTime11 = getcurrenttimeinmillis();
        //logTime("Rules New - Eval second lopp",endTime11-startTime11);
    }
    /*end of Evaluate the direct Rules*/
    ////print defaultsAndMessages;
    endTime = getcurrenttimeinmillis();
    logTime(modelName + logComments + "Rules New - eval", endTime - startTime);
    startTime = getcurrenttimeinmillis();
    relationshipJSONArrayFinal = jsonarray();
    recommendations = jsonget(defaultsAndMessages, "recommendations", "jsonarray", jsonarray());
    // //print recommendations;
    /*Chaining rules starts here*/
    startTime = getcurrenttimeinmillis();
    recIndexes = range(jsonarraysize(recommendations));
    for recInd in recIndexes {
        recObj = jsonarrayget(recommendations, recInd, "json");
        //added for implies target unselection Messages--start
        warning_messages_Childs_json = json();
        warning_messages_jsarr = jsonarray();
        sourceAttribute_d = jsonget(recObj, "sourceAttribute", "string", "");
        targetAttribute_d = jsonget(recObj, "targetAttribute", "string", "");
        targetIndex_d = jsonget(recObj, "targetIndex", "string", "");
        sourceIndex_d = jsonget(recObj, "sourceIndex", "string", "");
        deselctionApplied = jsonget(recObj, "deselctionApplied", "string", "");
        if (deselctionApplied <> "") { //defect - 28743 - dont execute chaining rules for override cases
            continue;
        }
        //added for implies target unselection Messages --END
        //relatedRuleJSON = json();
