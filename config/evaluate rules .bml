                targetSelectedNested = jsonpathcheck(ruleDataObj, "$.conditions[?(@.conditionId == '" + conditionIdNested + "' && @.targetConditionMet == true)]"); //Defect #29082 - PROC5410S - rule 41 - 409768 get excluded
                //isTargetExluded =  jsonget(relatedItemJSON,"isTargetExluded") == "true";//Defect #29082 - PROC5410S - rule 41 - 409768 get excluded
                isTargetExluded = jsonpathcheck(ruleDataObj, "$.conditions[?(@.conditionId == '" + conditionIdNested + "' && @.isTargetExluded == true)]"); //Defect #29082 - PROC5410S - rule 41 - 409768 get excluded
                defaultRuleNested = jsonget(relatedItemJSON, "defaultRule", "string", "");
                duplicate = ruleIdNested + "#" + sourceItemNested + "#" + targetItemNested;
                duplicate1 = ruleIdNested + "#" + targetItemNested + "#" + sourceItemNested; //IMC3510 Rule 110, chain rule 231 added two times with bidirectional
                if (findinarray(ToBeAppliedRuleIds, ruleIdNested) <> -1) { //dont consider the current applied rules in the nested rules
