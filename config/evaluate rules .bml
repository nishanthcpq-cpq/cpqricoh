mainunit_arrayset = "";
for eachInd in stepIndexes {
    stepObj = jsonarrayget(stepNamesJSONArr, eachInd, "json");
    dissplayStepName = jsonget(stepObj, "displayStepName", "string");
    stepName = jsonget(stepObj, "stepName", "string");
    arraySet = jsonget(stepObj, "arraysetName", "string");
    rulePath = jsonget(stepObj, "rulePath", "string");
    if (mainunit_arrayset == "" AND upper(jsonget(stepObj, "isMainDevice", "string", "")) == "Y") {
        mainunit_arrayset = arraySet;
    }
    //append(displayStepNamesArr,dissplayStepName);
    //append(stepNamesArr,stepName);
    if (endswith(trim(stepName), "OPTION CLASS")) {
        print "Name: " + trim(replace(trim(stepName), "OPTION CLASS", ""));
        append(displayStepNamesArr, dissplayStepName);
        append(stepNamesArr, trim(replace(trim(stepName), "OPTION CLASS", "")));
        append(rulePathsArr, rulePath);
        append(arraysetArr, arraySet);

        /*Defect 28951 - IMC2510  - rule 122 - RDR-805R1AKU-G3 not found issue*/
        append(displayStepNamesArr, dissplayStepName);
        append(stepNamesArr, stepName);
        append(rulePathsArr, rulePath);
        append(arraysetArr, arraySet);
    } else {
        append(displayStepNamesArr, dissplayStepName);
        append(stepNamesArr, stepName);
        append(rulePathsArr, rulePath);
        append(arraysetArr, arraySet);
    }


}
