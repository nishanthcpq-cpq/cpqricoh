RULES_TABLE = "";
if (dataTablesList <> "") {
    dataTablesListJSON = json(dataTablesList);
    RULES_TABLE = jsonget(dataTablesListJSON, "CONFIG_RULES", "string", "");

}
if (RULES_TABLE == "") {
    throwerror("Rules not found.");
}

jsonput(retVal, "DataTable", RULES_TABLE);
jsonput(retVal, "TypeOfProduct", pleaseChooseTheTypeOfTheProduct);
jsonput(retVal, "configureItem", configureItem);
jsonput(retVal, "configurationType", configurationType_Family);
jsonput(retVal, "orderType", orderType);
jsonput(retVal, "mainUnitEDPCode", mainUnitEDPCode);
jsonput(retVal, "mainUnitEDPCodePath", mainUnitEDPCodePath);
jsonput(retVal, "selectedAccount", selectedAccount);
jsonput(retVal, "logComments", "");
jsonput(retVal, "attributeAndValues", attributeAndValues);

//------------------Comparing Current and Previous attributeAndValues to find unslected Value
unselected_json_arr = jsonarray();
if (previousAttributeValueString <> "" AND NOT Isnull(previousAttributeValueString)) {
    print "=====================SRINI_9152025-1";
    print retVal;
    previousjson = json(previousAttributeValueString);
    Pre_attr_Values = jsonarray(jsonget(previousjson, "attributeAndValues"));
    temparr = range(jsonarraysize(Pre_attr_Values));
    for index in temparr {
        indexjs = json(jsonarrayget(Pre_attr_Values, index));
        arraySet = jsonget(indexjs, "arraySet", "string", "");
        if (arraySet <> "" AND NOT ISnull(arraySet)) {
            index = jsonget(indexjs, "index", "integer");
            pathcheck = "$..attributeAndValues[?(@.arraySet == '" + arraySet + "' && @.index == " + string(index) + " && @.value =='true')]";
            if (jsonpathcheck(retVal, pathcheck) == false) {
                jsonarrayappend(unselected_json_arr, indexjs);
            }

        }
    }
    print unselected_json_arr;
}
jsonput(retVal, "unselectedvalues", unselected_json_arr);
endTime = getcurrenttimeinmillis();
logTime(datetostr(getdate(true)) + _bm_model_variable_name + "Set Attribute Value String:Set Attribute val Attribute", endTime - startTime);
return jsontostr(retVal);