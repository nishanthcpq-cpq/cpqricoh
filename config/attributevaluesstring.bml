    mainDeviceArraySetName = jsonpathgetsingle(masterData, mainDevicePath, "string", "NotFound");
}
print mainDeviceArraySetName;
indexes = range(sizeofarray(arrsetAttributes));
previousAttributeValueJSON = json();
if (attributeValueString <> "" AND NOT Isnull(attributeValueString)) {

    previousAttributeValueJSON = json(attributeValueString);

}
for indx in indexes {
    arrayset = arrsetAttributes[indx];
    path = "$.." + arrayset;
    if (jsonpathcheck(masterData, path)) {
        arrSelect = split(get(selectDict, arrSelectAttributes[indx]), "$,$");
        //print arrSelect;
        arrItems = get(itemDict, arrItemAttributes[indx]);
        //print arrItems;
        arrQtys = get(qtyDict, arrQtyAttributes[indx]);
        //print arrQtys;
        arrSetTypes = get(setTypeDict, arrSetTypeAttributes[indx]);
        arroverrides = string[];
        if (containskey(overidesdict, arroverrideAttributes[indx])) {
            arroverrides = split(get(overidesdict, arroverrideAttributes[indx]), "$,$");
            //print arroverrides;
        }
        bundlePath = "$.stepNames[?(@.IsBundle == 'Y')].arraysetName";
        if (jsonpathcheck(masterData, bundlePath)) {
            bundleArraySet = jsonpathgetsingle(masterData, bundlePath, "string", "NotFound");
            bundleArraySetPos = findinarray(arrsetAttributes, bundleArraySet);
            if (bundleArraySetPos <> -1) {
                selectAttr = arrSelectAttributes[bundleArraySetPos];
                if (containskey(selectDict, selectAttr)) {
                    bundleSelction = get(selectDict, selectAttr);
                    if (find(bundleSelction, "true") <> -1 and arrayset <> bundleArraySet) {
                        continue;
                    }
                }
            }

        }
        indexes1 = range(sizeofarray(arrSelect));
        for i in indexes1 {
            //print mainDeviceArraySetName;
            //print arrsetAttributes[indx];
            if (mainDeviceArraySetName == arrsetAttributes[indx] and arrSelect[i] <> "true") { //defaulting device
                arrSelect[i] = "true";
                arrItems[i] = jsonpathgetsingle(masterData, path + "[0].partNumber", "string", "NotFound");
                //arrItems[i] = jsonpathgetsingle(masterData, path+"["+string(i)+"].partNumber","string","NotFound");
                print "arrItems[i] arrItems[i] " + arrItems[i];
            }
            //print arrSelect[i];
            if (arrSelect[i] == "true" OR arroverrides[i] == "true") {
                attrValueObj = json();
                jsonput(attrValueObj, "arraySet", arrsetAttributes[indx]);
                jsonput(attrValueObj, "attribute", "");
                jsonput(attrValueObj, "selectAttribute", arrSelectAttributes[indx]);
                jsonput(attrValueObj, "itemAttribute", arrItemAttributes[indx]);
                jsonput(attrValueObj, "qtyAttribute", arrQtyAttributes[indx]);
                jsonput(attrValueObj, "value", arrSelect[i]);
                if (arroverrides[i] == "true") { ////Defect 29912 - override issue
                    jsonput(attrValueObj, "value", arroverrides[i]);
                }
                jsonput(attrValueObj, "index", i);
                jsonput(attrValueObj, "item", arrItems[i]);
                jsonput(attrValueObj, "Override", arroverrides[i]);
                jsonput(attrValueObj, "quantity", arrQtys[i]);
                jsonput(attrValueObj, "type", "ARRAY");
                if (arrSetTypes[i] <> "") {
                    jsonput(attrValueObj, "selectionSource", "RULE");
                } else {
                    jsonput(attrValueObj, "selectionSource", "USER");
                }


                //pathcheck="$..attributeAndValues[?(@.arraySet == '"+arraySet+"' && @.item== '"+arrItems[i]+"' && @.value =='true')].selectedAt";
                pathcheck = "$..attributeAndValues[?(@.arraySet == '" + arraySet + "' &&  @.item == '" + arrItems[i] + "')].selectedAt"; //Defect 29912 - override issue

                logtime("from attr val string " + pathcheck, 200);
                if (jsonpathcheck(previousAttributeValueJSON, pathcheck)) {
                    logtime("from attr val string1 " + pathcheck, 200);
                    selectedAt = jsonpathgetsingle(previousAttributeValueJSON, pathcheck);
                    jsonput(attrValueObj, "selectedAt", selectedAt);
                } else {
                    logtime("from attr val string2 " + pathcheck, 200);
                    jsonput(attrValueObj, "selectedAt", getcurrenttimeinmillis());
                }
                optionFeature = "";
                optionFeaturePath = path + ".[?(@.partNumber == '" + arrItems[i] + "')].rulePath";
                if (jsonpathcheck(masterData, optionFeaturePath)) {
                    optionFeature = jsonpathgetsingle(masterData, optionFeaturePath, "string", "");
                }
                jsonput(attrValueObj, "optionFeature", optionFeature);
                //--------------SG added	
                stepname = "";
                stepnamePath = path + ".[?(@.partNumber == '" + arrItems[i] + "')].stepName";
                if (jsonpathcheck(masterData, stepnamePath)) {
                    stepname = jsonpathgetsingle(masterData, stepnamePath, "string", "");
                }
                jsonput(attrValueObj, "stepName", stepname);
                //----------------		
                isBundle = "N";
                bundlePath = "$.stepNames[?(@.arraysetName == '" + arrsetAttributes[indx] + "')].IsBundle";
                if (jsonpathcheck(masterData, bundlePath)) {
                    isBundle = jsonpathgetsingle(masterData, bundlePath, "string", "N");
                }
                jsonput(attrValueObj, "IsBundle", isBundle);

                jsonarrayappend(attributeAndValues, attrValueObj);
            }
        }

    }
}
jsonput(retVal, "modelName", _bm_model_variable_name);
jsonput(retVal, "orderType", orderType);
// 10-23-2026 CHG0105953 --Start
if (selectedPreowned <> "") {
    keyArray = jsonkeys(json(selectedPreowned));
    keysplitArr = split(keyArray[0], "#");
    attrValueObj = json();
    jsonput(attrValueObj, "Serial_Number", keysplitArr[1]); //
    if (find(keyArray[0], "#") <> -1) {
        selectedItems = jsonget(json(selectedPreowned), keyArray[0], "jsonarray", jsonarray());
        indexes = range(jsonarraysize(selectedItems));
        for i in indexes {
            itemObj = jsonarrayget(selectedItems, i, "json");
            WareHouse = jsonget(itemObj, "WareHouse", "string", "");
            jsonput(attrValueObj, "WareHouse", WareHouse); //Serial_Number  
        }
        jsonput(retVal, "selectedPreowned", attrValueObj);
    }
}
