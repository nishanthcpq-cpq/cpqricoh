b = 0;
if (masterDataString <> "") {
	master = json(masterDataString);
	selectionFromMaster = json(attributeValueString);
	u = jsonarraytostr(jsonpathgetmultiple(master, "$.stepNames..Order"));
	y = substring(u, 1, len(u) - 1);
	seq1 = split(y, ",");
	for ea in seq1 {
		stepNameValue = jsonpathgetsingle(master, "$.stepNames[" + string(b) + "].displayStepName", "string");
		attributeNameValue = jsonpathgetsingle(master, "$.stepNames[" + string(b) + "].attributeName", "string");
		arraysetNameValue = jsonpathgetsingle(master, "$.stepNames[" + string(b) + "].arraysetName", "string");
		orderValue = jsonpathgetsingle(master, "$.stepNames[" + string(b) + "].Order", "string");
		if ((stepNameValue <> "") AND (arraysetNameValue <> "")) {
			append(arraySetNames, arraysetNameValue);
			stepName = stepNameValue;
			seq = orderValue;
			arraySetName = arraysetNameValue;
			put(ord, arraySetName, seq);
			put(step, arraySetName, stepName);
		} elif ((stepNameValue <> "") AND (attributeNameValue <> "")) {
			append(arraySetNames, attributeNameValue);
			stepName = stepNameValue;
			seq = orderValue;
			attributeName = attributeNameValue;
			put(ord, attributeName, seq);
			put(step, attributeName, stepName);
		}
		b = b + 1;
	}
	print arraySetNames;
	k = 0;
	for each in arraySetNames {
		//sbappend(retVal, ".optionFeature"+string(k+1)+"Arrayset .oj-label-group h3{font-size:0; text-align:left;}");
		//sbappend(retVal, ".optionFeature"+string(k+1)+"Arrayset .oj-label-group h3::before{font-size:14px;content:'"+get(step,arraySetNames[k])+"';}");
		sbappend(retVal, "." + each + " .oj-label-group h3{font-size:0; text-align:left;}");
		sbappend(retVal, "." + each + " .oj-label-group h3::before{font-size:14px;content:'" + get(step, arraySetNames[k]) + "';}");
		k = k + 1;
	}
	for eack in arraySetNames {
		pathify = "$.attributeAndValues[?(((@.arraySet == '" + eack + "')||(@.attribute == '" + eack + "'))&&(@.item != ''))]..arraySet";
		if (jsonpathcheck(selectionFromMaster, pathify)) {
			pathiz = "$.stepNames[?((@.arraysetName == '" + eack + "')||(@.attributeName == '" + eack + "'))].displayStepName";
			stepLook = jsonpathgetsingle(master, pathiz);
			print jsonpathgetsingle(master, pathiz);
			print eack;
			print "Success";
			sbappend(retVal, "#selectStep a[title='" + stepLook + "']{ background-color:  #C5E1A5 !important;}");
			sbappend(retVal, "#selectStep a[title='" + stepLook + "'] h5{ color: #526C4B !important; font-weight: bold !important;}");
		}
	}
	sbappend(retVal, ".oj-table-data-cell.oj-selected{background-image:linear-gradient(#fff, #fff) !important;}");
	sbappend(retVal, "#selectStep a[title='']{ display:none !important;}");
	sbappend(retVal, "#pleaseChooseTheTypeOfTheProduct- a[title='None']{ display:none !important;}");
}
